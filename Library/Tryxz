    local ShowStats = config.Stats ~= false
    local Keybind = config.ToggleKey or Enum.KeyCode.RightControl
    local HapticsEnabled = config.Haptics ~= false
    local KeyConfig = config.KeySystem

    -- ==========================================
    -- SAVE CONFIG SYSTEM
    -- ==========================================
    local SaveEnabled = false
    local SaveFolder = "TryxzLibConfigs"
    local SaveFile = SaveFolder .. "/" .. tostring(Title):gsub("[^%w_-]", "_") .. ".json"
    local SavedData = {}
    local HasExistingSave = false
    local RegisteredFlags = {}

    if type(config.SaveConfig) == "boolean" then
        SaveEnabled = config.SaveConfig
    elseif type(config.SaveConfig) == "table" then
        SaveEnabled = config.SaveConfig.Enabled ~= false
        if config.SaveConfig.Folder then SaveFolder = config.SaveConfig.Folder end
        local fName = config.SaveConfig.FileName or tostring(Title):gsub("[^%w_-]", "_")
        SaveFile = SaveFolder .. "/" .. fName .. ".json"
    end

    local function WriteConfigFile()
        if not SaveEnabled then return end
        pcall(function()
            if makefolder and isfolder and not isfolder(SaveFolder) then
                makefolder(SaveFolder)
            end
            if writefile then
                SavedData["_Haptics"] = HapticsEnabled
                SavedData["_Sounds"] = SoundConfig.Enabled
                writefile(SaveFile, HttpService:JSONEncode(SavedData))
            end
        end)
    end

    if SaveEnabled then
        pcall(function()
            if isfile and readfile and isfile(SaveFile) then
                local raw = readfile(SaveFile)
                local decoded = HttpService:JSONDecode(raw)
                if type(decoded) == "table" then
                    SavedData = decoded
                    HasExistingSave = true
                    if SavedData["_Haptics"] ~= nil then HapticsEnabled = SavedData["_Haptics"] end
                    if SavedData["_Sounds"] ~= nil then SoundConfig.Enabled = SavedData["_Sounds"] end
                end
            end
        end)
    end

    -- Apply custom Sound settings if provided
    if type(config.Sounds) == "boolean" then
        if not HasExistingSave then SoundConfig.Enabled = config.Sounds end
    elseif type(config.Sounds) == "table" then
        if config.Sounds.Enabled ~= nil and not HasExistingSave then SoundConfig.Enabled = config.Sounds.Enabled end
        if config.Sounds.Volume ~= nil then SoundConfig.Volume = config.Sounds.Volume end
        for k, v in pairs(config.Sounds) do
            if SoundConfig[k] ~= nil and k ~= "Enabled" and k ~= "Volume" then
                SoundConfig[k] = v
            end
        end
    end

    local function TriggerHaptic(strength)
        if not HapticsEnabled then return end
        pcall(function()
            HapticService:SetMotor(Enum.UserInputType.Gamepad1, Enum.VibrationMotor.Small, strength or 0.35)
            task.delay(0.06, function()
                HapticService:SetMotor(Enum.UserInputType.Gamepad1, Enum.VibrationMotor.Small, 0)
