local function CheckKeyValid(KeyConfig, entered)
    local ValidKeys = KeyConfig.Keys or (KeyConfig.Key and {KeyConfig.Key}) or {"tryxz"}
    if type(ValidKeys) == "function" then
        return ValidKeys(entered) == true
    elseif type(ValidKeys) == "table" then
        for _, k in ipairs(ValidKeys) do
            if tostring(entered) == tostring(k) then return true end
        end
    elseif type(ValidKeys) == "string" then
        return tostring(entered) == ValidKeys
    end
    return false
end

