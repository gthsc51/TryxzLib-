    FloatingUIBtn.TextColor3 = Theme.Text
    FloatingUIBtn.Font = Enum.Font.GothamBold
    FloatingUIBtn.TextSize = 13
    FloatingUIBtn.AutoButtonColor = false
    FloatingUIBtn.Visible = false
    FloatingUIBtn.ZIndex = 20
