            StateVal = val
            if Flag and not skipWrite then Cfg.SavedData[Flag] = StateVal WriteConfigFile() end
            if not silent then
                SpawnRipple(ToggleBtn, Theme.Accent)
                TriggerHaptic(0.28)
                TryxzLib:PlaySound(tCfg.Sound or "Toggle")
            end
            Tween(SwitchBg, Tweens.Fast, {BackgroundColor3 = StateVal and Theme.Accent or Theme.Background})
            Tween(SwStroke, Tweens.Fast, {Color = StateVal and Theme.AccentSecondary or Theme.Divider})
