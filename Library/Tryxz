local function Tween(obj, info, props)
    local t = TweenService:Create(obj, info, props)
    t:Play()
    return t
end

-- Helper to apply icon (supports rbxassetid:// or text/emoji)
local function CreateIcon(parent, iconValue, size, pos, zindex)
    if not iconValue or iconValue == "" then return nil end
    local isAsset = tostring(iconValue):find("rbxassetid://") or tonumber(iconValue)
    if isAsset then
        local assetId = tonumber(iconValue) and ("rbxassetid://" .. tostring(iconValue)) or tostring(iconValue)
        local img = Instance.new("ImageLabel")
        img.Size = UDim2.new(0, size, 0, size)
        img.Position = pos
        img.BackgroundTransparency = 1
        img.Image = assetId
        img.ScaleType = Enum.ScaleType.Fit
        img.ZIndex = zindex or 2
        img.Parent = parent
        return img
    else
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(0, size, 0, size)
        lbl.Position = pos
        lbl.BackgroundTransparency = 1
        lbl.Text = tostring(iconValue)
        lbl.TextColor3 = Color3.fromRGB(240, 240, 245)
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = size - 2
        lbl.ZIndex = zindex or 2
        lbl.Parent = parent
        return lbl
    end
end

