        ToggleBtn.MouseButton1Click:Connect(function() UpdateToggle(not StateVal, false, false) end)

        if StateVal then
            task.spawn(Callback, true)
        end

        local ToggleObj = WrapElementControls(ToggleBtn, tCfg)
        function ToggleObj:Set(val, skipWrite) UpdateToggle(val, true, skipWrite) end
        function ToggleObj:Get() return StateVal end
        if Flag then Window.Flags[Flag] = ToggleObj end

        if RegisterBindable and tCfg.Bindable ~= false then
            RegisterBindable({
                Id = bindId,
                Name = tCfg.Name or "Toggle",
                Kind = "Toggle",
                DefaultKey = tCfg.Keybind,
                Trigger = function() UpdateToggle(not StateVal, false, false) end
            })
        end

        return ToggleObj
    end

    -- 9. SLIDER
    function API:AddSlider(sCfg)
        local Flag = sCfg.Flag
        local Min, Max = sCfg.Min or 0, sCfg.Max or 100
        local Default = math.clamp(sCfg.Default or Min, Min, Max)
        local CurrentVal = Default
        local StepVal = sCfg.KeyStep or sCfg.Step or math.max(1, math.floor((Max - Min) * 0.05))
        local Callback = sCfg.Callback or function() end

        if Cfg.SaveEnabled and Flag and Cfg.SavedData[Flag] ~= nil then
            Default = math.clamp(tonumber(Cfg.SavedData[Flag]) or Default, Min, Max)
            CurrentVal = Default
        end

        local SliderFrame = Instance.new("Frame")
        SliderFrame.LayoutOrder = NextOrder()
        SliderFrame.Size = UDim2.new(1, 0, 0, 46)
