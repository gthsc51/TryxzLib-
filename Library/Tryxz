        end
        function DropObj:Refresh(newList, newIcons)
            RebuildOptions(newList, newIcons)
            if Open then
                Tween(DropFrame, Tweens.Fast, {Size = UDim2.new(1, 0, 0, GetOpenHeight())})
            end
        end
        if Flag then Window.Flags[Flag] = DropObj end
        return DropObj
    end

    -- 15. PLAYER DROPDOWN
    function API:AddPlayerDropdown(pCfg)
        local excludeSelf = pCfg.ExcludeLocalPlayer == true
        local function GatherPlayers()
            local names, icons = {}, {}
            for _, plr in ipairs(Players:GetPlayers()) do
                if not (excludeSelf and plr == LocalPlayer) then
                    table.insert(names, plr.Name)
                    icons[plr.Name] = "rbxthumb://type=AvatarHeadShot&id=" .. tostring(plr.UserId) .. "&w=100&h=100"
                end
            end
            if #names == 0 then table.insert(names, "No players available") end
            return names, icons
        end

        local initNames, initIcons = GatherPlayers()
        local drop = API:AddDropdown({
            Name = pCfg.Name or "Select Player",
            Icon = pCfg.Icon or "rbxassetid://10747373176",
            Flag = pCfg.Flag,
            Options = initNames,
            OptionIcons = initIcons,
            Default = initNames[1],
            Searchable = true,
            Tooltip = pCfg.Tooltip or "Auto-updated live server player list",
            Callback = pCfg.Callback
        })

        local function RefreshList()
            local n, ic = GatherPlayers()
            drop:Refresh(n, ic)
        end

        Players.PlayerAdded:Connect(RefreshList)
        Players.PlayerRemoving:Connect(function() task.defer(RefreshList) end)
        return drop
    end

