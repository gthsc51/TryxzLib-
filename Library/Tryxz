            stripe.Position = UDim2.new(0, 3, 0, 2)
            stripe.BackgroundColor3 = LevelColors[level] or Theme.SubText
            stripe.BorderSizePixel = 0
            stripe.Parent = row
            Instance.new("UICorner", stripe).CornerRadius = UDim.new(1, 0)

            local entry = Instance.new("TextLabel")
            entry.Size = UDim2.new(1, -12, 0, 0)
            entry.Position = UDim2.new(0, 9, 0, 2)
            entry.AutomaticSize = Enum.AutomaticSize.Y
            entry.BackgroundTransparency = 1
            entry.Text = lineStr
            entry.TextColor3 = LevelColors[level] or Theme.SubText
            entry.Font = Enum.Font.Code
            entry.TextSize = 10
            entry.TextWrapped = true
            entry.TextXAlignment = Enum.TextXAlignment.Left
            entry.Parent = row

            task.defer(function()
                Scroll.CanvasPosition = Vector2.new(0, Scroll.AbsoluteCanvasSize.Y)
            end)
        end

        function ConsoleObj:Clear()
            history = {}
            CountLbl.Text = "0 logs"
            for _, c in ipairs(Scroll:GetChildren()) do
                if c:IsA("Frame") then c:Destroy() end
            end
        end

        ClearBtn.MouseButton1Click:Connect(function() ConsoleObj:Clear() end)
        return ConsoleObj
    end

    return API
end

-- ==========================================
-- CREATE MAIN WINDOW (WITH MANDATORY GOLD STARTUP INTRO)
-- ==========================================
function TryxzLib:CreateWindow(config)
    config = config or {}
    local Cfg = {
        Title = config.Title or "TryxzLib",
        Subtitle = config.Subtitle or "",
        Icon = config.Icon,
        Profile = config.Profile ~= false,
        Stats = config.Stats ~= false,
        SearchBar = config.SearchBar ~= false,
        Keybind = config.ToggleKey or Enum.KeyCode.RightControl,
        Haptics = config.Haptics ~= false,
        UIScale = 1,
        SaveEnabled = false,
        SaveKey = false,
        SavedKey = nil,
        SaveFolder = "TryxzLibConfigs",
        ActiveProfile = "default",
        AutoLoadPlaceId = false,
        SaveFile = "",
        SavedData = {},
        HasExistingSave = false,
        WinW = 515,
        WinH = 322,
        TopH = 44,
        SideW = 156
    }

    local State = {
        Minimized = false,
        Collapsed = false,
        Hidden = false,
        SettingsOpen = false
    }

    if config.NotifPosition then DefaultNotifPosition = config.NotifPosition end

    if type(config.Blur) == "boolean" then
        BlurState.Enabled = config.Blur
    elseif type(config.Blur) == "table" then
        BlurState.Enabled = config.Blur.Enabled ~= false
        if config.Blur.Size then BlurState.TargetSize = math.clamp(tonumber(config.Blur.Size) or 14, 2, 40) end
    end

    if type(config.CustomThemes) == "table" then
        for tName, tPal in pairs(config.CustomThemes) do
            TryxzLib:AddTheme(tName, tPal)
        end
    end

    if config.Theme and Themes[config.Theme] then TryxzLib:SetTheme(config.Theme) end
    if config.Accent then TryxzLib:SetAccent(config.Accent) end

    if type(config.SaveConfig) == "boolean" then
        Cfg.SaveEnabled = config.SaveConfig
    elseif type(config.SaveConfig) == "table" then
        Cfg.SaveEnabled = config.SaveConfig.Enabled ~= false
        Cfg.SaveKey = config.SaveConfig.SaveKey == true
        Cfg.AutoLoadPlaceId = config.SaveConfig.AutoLoadPlaceId == true
        if config.SaveConfig.Folder then Cfg.SaveFolder = config.SaveConfig.Folder end
        if config.SaveConfig.DefaultProfile then Cfg.ActiveProfile = tostring(config.SaveConfig.DefaultProfile) end
        if Cfg.AutoLoadPlaceId then
            Cfg.ActiveProfile = "place_" .. tostring(game.PlaceId)
        end
    end

    local BasePrefix = (type(config.SaveConfig) == "table" and config.SaveConfig.FileName) or tostring(Cfg.Title):gsub("[^%w_-]", "_")
    local KeyStorageFile = Cfg.SaveFolder .. "/" .. BasePrefix .. "_key.txt"

    local function GetProfilePath(profName)
        local clean = tostring(profName):gsub("[^%w_-]", "_")
        if clean == "" then clean = "default" end
        return Cfg.SaveFolder .. "/" .. BasePrefix .. "_" .. clean .. ".json"
    end
    Cfg.SaveFile = GetProfilePath(Cfg.ActiveProfile)

    local function WriteConfigFile()
        if not Cfg.SaveEnabled then return end
        pcall(function()
            if makefolder and isfolder and not isfolder(Cfg.SaveFolder) then makefolder(Cfg.SaveFolder) end
            if writefile then
                Cfg.SavedData["_Haptics"] = Cfg.Haptics
                Cfg.SavedData["_Sounds"] = SoundState.Enabled
                Cfg.SavedData["_SoundPreset"] = SoundState.Preset
                Cfg.SavedData["_UIScale"] = Cfg.UIScale
                Cfg.SavedData["_Blur"] = BlurState.Enabled
                Cfg.SavedData["_ThemeName"] = ActiveThemeName
                Cfg.SavedData["_Accent"] = {Theme.Accent.R, Theme.Accent.G, Theme.Accent.B}
                writefile(Cfg.SaveFile, HttpService:JSONEncode(Cfg.SavedData))
                if Cfg.SaveKey and Cfg.SavedKey then
                    writefile(KeyStorageFile, tostring(Cfg.SavedKey))
                end
            end
        end)
    end

    local function ReadProfileData(profName)
        local path = GetProfilePath(profName)
        local result = nil
        pcall(function()
            if isfile and readfile and isfile(path) then
                local decoded = HttpService:JSONDecode(readfile(path))
                if type(decoded) == "table" then result = decoded end
            end
        end)
        return result
    end

    if config.Sounds ~= nil then TryxzLib:SetSounds(config.Sounds) end

    if Cfg.SaveEnabled then
        pcall(function()
            if isfile and readfile and isfile(KeyStorageFile) then
                Cfg.SavedKey = readfile(KeyStorageFile)
            end
        end)
        local initialData = ReadProfileData(Cfg.ActiveProfile)
        if initialData then
            Cfg.SavedData = initialData
            Cfg.HasExistingSave = true
            if initialData["_Haptics"] ~= nil then Cfg.Haptics = initialData["_Haptics"] end
            if initialData["_Sounds"] ~= nil then SoundState.Enabled = initialData["_Sounds"] end
            if initialData["_Blur"] ~= nil then BlurState.Enabled = initialData["_Blur"] end
            if initialData["_UIScale"] ~= nil then Cfg.UIScale = math.clamp(tonumber(initialData["_UIScale"]) or 1, 0.75, 1.35) end
            if initialData["_SoundPreset"] and SoundPresets[initialData["_SoundPreset"]] then
                TryxzLib:SetSoundPreset(initialData["_SoundPreset"])
            end
            if initialData["_ThemeName"] and Themes[initialData["_ThemeName"]] then
                TryxzLib:SetTheme(initialData["_ThemeName"])
            end
            if type(initialData["_Accent"]) == "table" and #initialData["_Accent"] == 3 then
