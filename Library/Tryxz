        function entry:SetKey(newKey, skipWrite)
            if newKey == nil or newKey == "None" then
                self.Key = nil
                self.Badge.Text = "None"
                self.Badge.TextColor3 = Theme.SubText
            else
                if type(newKey) == "string" and Enum.KeyCode[newKey] then newKey = Enum.KeyCode[newKey] end
                self.Key = newKey
                self.Badge.Text = newKey.Name
                self.Badge.TextColor3 = Theme.Accent
            end
            if Cfg.SaveEnabled and not skipWrite then
                Cfg.SavedData["_FnBinds"] = Cfg.SavedData["_FnBinds"] or {}
                Cfg.SavedData["_FnBinds"][self.Id] = self.Key and self.Key.Name or "None"
                WriteConfigFile()
            end
        end

        KeyBadgeBtn.MouseButton1Click:Connect(function()
            TriggerHaptic(0.25)
