            SelectedLbl.Text = "None"
            SelectedLbl.TextColor3 = Theme.Accent
            SelectedLbl.Font = Enum.Font.Gotham
            SelectedLbl.TextSize = 11
            SelectedLbl.TextXAlignment = Enum.TextXAlignment.Right
            SelectedLbl.TextTruncate = Enum.TextTruncate.AtEnd
            SelectedLbl.Parent = Header

            local Arrow = Instance.new("TextLabel")
            Arrow.Size = UDim2.new(0, 18, 0, 18)
            Arrow.Position = UDim2.new(1, -24, 0.5, -9)
            Arrow.BackgroundTransparency = 1
            Arrow.Text = "▼"
            Arrow.TextColor3 = Theme.SubText
            Arrow.Font = Enum.Font.GothamBold
            Arrow.TextSize = 9
            Arrow.Parent = Header

            local ListHolder = Instance.new("Frame")
            ListHolder.Size = UDim2.new(1, -12, 0, 0)
            ListHolder.Position = UDim2.new(0, 6, 0, 34)
            ListHolder.BackgroundTransparency = 1
            ListHolder.Parent = DropFrame

            local ListLayout = Instance.new("UIListLayout", ListHolder)
            ListLayout.Padding = UDim.new(0, 4)
            ListLayout.SortOrder = Enum.SortOrder.LayoutOrder

            local function UpdateSummary(shouldSave)
                local activeList = {}
                for k, v in pairs(Selected) do
                    if v then table.insert(activeList, tostring(k)) end
                end
                SelectedLbl.Text = #activeList > 0 and table.concat(activeList, ", ") or "None"
                if shouldSave and Flag then Cfg.SavedData[Flag] = activeList WriteConfigFile() end
                task.spawn(Callback, activeList)
            end

            Header.MouseButton1Click:Connect(function()
                TriggerHaptic(0.2)
                tryxzlib:PlaySound("Click")
                Open = not Open
                Tween(DropFrame, Tweens.Smooth, {Size = UDim2.new(1, 0, 0, Open and (38 + (#Options * 26)) or 32)})
                Tween(Arrow, Tweens.Smooth, {Rotation = Open and 180 or 0})
            end)

            for i, opt in ipairs(Options) do
                local OptBtn = Instance.new("TextButton")
                OptBtn.LayoutOrder = i
                OptBtn.Size = UDim2.new(1, 0, 0, 22)
                OptBtn.BackgroundColor3 = Selected[opt] and Theme.Accent or Theme.Background
                OptBtn.Text = "  " .. tostring(opt)
                OptBtn.TextColor3 = Selected[opt] and Theme.Text or Theme.SubText
                OptBtn.Font = Enum.Font.Gotham
                OptBtn.TextSize = 11
                OptBtn.TextXAlignment = Enum.TextXAlignment.Left
                OptBtn.AutoButtonColor = false
                OptBtn.Parent = ListHolder
                Instance.new("UICorner", OptBtn).CornerRadius = UDim.new(0, 9)

                OptBtn.MouseButton1Click:Connect(function()
                    TriggerHaptic(0.25)
                    tryxzlib:PlaySound("Toggle")
                    Selected[opt] = not Selected[opt]
                    Tween(OptBtn, Tweens.Fast, {
                        BackgroundColor3 = Selected[opt] and Theme.Accent or Theme.Background,
                        TextColor3 = Selected[opt] and Theme.Text or Theme.SubText
                    })
                    UpdateSummary(true)
                end)
            end

            UpdateSummary(false)
        end

        return TabAPI
    end

    return Window
end

return tryxzlib
 
