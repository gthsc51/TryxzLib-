function tryxzlib:PlaySound(soundOrType, customVolume)
    if not SoundConfig.Enabled then return end
    local id = SoundConfig[soundOrType] or tostring(soundOrType)
    if not id or id == "" then return end
    if tonumber(id) then id = "rbxassetid://" .. id end
    task.spawn(function()
        pcall(function()
            local snd = Instance.new("Sound")
            snd.SoundId = id
            snd.Volume = customVolume or SoundConfig.Volume
            snd.Parent = SoundService
            snd:Play()
            snd.Ended:Connect(function() snd:Destroy() end)
            task.delay(3, function() if snd and snd.Parent then snd:Destroy() end end)
        end)
    end)
end

