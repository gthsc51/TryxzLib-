local ScrambleGlyphs = {"#", "@", "%", "&", "0", "1", "X", "Z", "/", "+"}
local function ScrambleText(labelObj, targetText, duration)
    if not labelObj or not labelObj.Parent then return end
    targetText = tostring(targetText)
    local len = #targetText
    if len == 0 then labelObj.Text = "" return end
    task.spawn(function()
        local steps = math.clamp(math.floor((duration or 0.28) / 0.025), 5, 16)
        for s = 1, steps do
            if not labelObj or not labelObj.Parent then return end
            local revealed = math.floor((s / steps) * len)
            local out = string.sub(targetText, 1, revealed)
            for j = revealed + 1, len do
                local ch = string.sub(targetText, j, j)
                if ch == " " then
                    out = out .. " "
                else
                    out = out .. ScrambleGlyphs[math.random(1, #ScrambleGlyphs)]
                end
            end
            labelObj.Text = out
            task.wait(0.025)
        end
        if labelObj and labelObj.Parent then
            labelObj.Text = targetText
        end
    end)
end

local function SpawnRipple(buttonObj, customColor)
    if not buttonObj or not buttonObj.Parent then return end
    task.spawn(function()
        local mousePos = UserInputService:GetMouseLocation()
        local absPos = buttonObj.AbsolutePosition
        local absSize = buttonObj.AbsoluteSize
        local relX = math.clamp(mousePos.X - absPos.X, 0, absSize.X)
        local relY = math.clamp(mousePos.Y - absPos.Y, 0, absSize.Y)
        if mousePos.X == 0 and mousePos.Y == 0 then
            relX, relY = absSize.X * 0.5, absSize.Y * 0.5
        end

        local ripple = Instance.new("Frame")
        ripple.Name = "ClickRipple"
        ripple.AnchorPoint = Vector2.new(0.5, 0.5)
        ripple.Position = UDim2.new(0, relX, 0, relY)
        ripple.Size = UDim2.new(0, 0, 0, 0)
        ripple.BackgroundColor3 = customColor or Color3.fromRGB(255, 255, 255)
        ripple.BackgroundTransparency = 0.72
        ripple.BorderSizePixel = 0
        ripple.ZIndex = (buttonObj.ZIndex or 2) + 2
        ripple.Parent = buttonObj
        Instance.new("UICorner", ripple).CornerRadius = UDim.new(1, 0)

        local maxDim = math.max(absSize.X, absSize.Y) * 2.2
        local t = Tween(ripple, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, maxDim, 0, maxDim),
            BackgroundTransparency = 1
        })
        t.Completed:Wait()
        if ripple then ripple:Destroy() end
    end)
end

