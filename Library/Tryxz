                Transparency = StateVal and 0.2 or 0.55
            })
            Tween(Knob, TweenInfo.new(0.1, Enum.EasingStyle.Quad), {Size = UDim2.new(0, 18, 0, 14)})
            task.delay(0.09, function()
                if Knob and Knob.Parent then
                    Tween(Knob, Tweens.Bounce, {
                        Size = UDim2.new(0, 14, 0, 14),
                        Position = StateVal and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
                    })
                end
            end)
            Tween(KnobCore, Tweens.Bounce, {Size = StateVal and UDim2.new(0, 6, 0, 6) or UDim2.new(0, 0, 0, 0)})
            Window:RefreshVisibility()
            task.spawn(Callback, StateVal)
        end

        ToggleBtn.MouseEnter:Connect(function() Tween(ToggleBtn, Tweens.Fast, {BackgroundColor3 = Theme.ElementHover}) end)
