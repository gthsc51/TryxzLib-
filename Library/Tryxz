-- ==========================================
-- DETACHED ELEMENT FACTORY (Shared by Tabs & SubTabs)
-- ==========================================
local function CreateElementFactory(Container, Window, Cfg, TriggerHaptic, WriteConfigFile, RegisterSearchable)
    local API = {}
    local ElementOrder = 0
    local function NextOrder() ElementOrder += 1 return ElementOrder end

    -- 1. SECTION
    function API:AddSection(text)
        local SecFrame = Instance.new("Frame")
        SecFrame.LayoutOrder = NextOrder()
        SecFrame.Size = UDim2.new(1, 0, 0, 24)
        SecFrame.BackgroundColor3 = Theme.GrayTranslucent
        SecFrame.BackgroundTransparency = 0.65
        SecFrame.Parent = Container
        Instance.new("UICorner", SecFrame).CornerRadius = UDim.new(0, 10)

        local SecLbl = Instance.new("TextLabel")
        SecLbl.Size = UDim2.new(1, -16, 1, 0)
        SecLbl.Position = UDim2.new(0, 10, 0, 0)
        SecLbl.BackgroundTransparency = 1
        SecLbl.Text = string.upper(text)
        SecLbl.TextColor3 = Theme.SubText
        SecLbl.Font = Enum.Font.GothamBold
        SecLbl.TextSize = 10
        SecLbl.TextXAlignment = Enum.TextXAlignment.Left
        SecLbl.Parent = SecFrame
        return SecLbl
    end

    -- 2. DIVIDER
    function API:AddDivider()
        local DivHolder = Instance.new("Frame")
        DivHolder.LayoutOrder = NextOrder()
        DivHolder.Size = UDim2.new(1, 0, 0, 8)
        DivHolder.BackgroundTransparency = 1
        DivHolder.Parent = Container

        local Line = Instance.new("Frame")
        Line.Size = UDim2.new(0, 0, 0, 1)
        Line.Position = UDim2.new(0.5, 0, 0.5, 0)
        Line.AnchorPoint = Vector2.new(0.5, 0.5)
        Line.BackgroundColor3 = Theme.Divider
        Line.BackgroundTransparency = 0.3
        Line.BorderSizePixel = 0
        Line.Parent = DivHolder
        Instance.new("UICorner", Line).CornerRadius = UDim.new(1, 0)
        Tween(Line, Tweens.Elastic, {Size = UDim2.new(0.96, 0, 0, 1)})
    end

    -- 3. LABEL
    function API:AddLabel(text)
        local LblFrame = Instance.new("Frame")
        LblFrame.LayoutOrder = NextOrder()
        LblFrame.Size = UDim2.new(1, 0, 0, 28)
        LblFrame.BackgroundColor3 = Theme.GrayTranslucent
        LblFrame.BackgroundTransparency = 0.6
        LblFrame.Parent = Container
        Instance.new("UICorner", LblFrame).CornerRadius = UDim.new(0, 12)
        RegisterSearchable(text, LblFrame)

        local Lbl = Instance.new("TextLabel")
        Lbl.Size = UDim2.new(1, -18, 1, 0)
        Lbl.Position = UDim2.new(0, 10, 0, 0)
        Lbl.BackgroundTransparency = 1
        Lbl.Text = text
        Lbl.TextColor3 = Theme.SubText
        Lbl.Font = Enum.Font.Gotham
        Lbl.TextSize = 11
        Lbl.TextXAlignment = Enum.TextXAlignment.Left
        Lbl.Parent = LblFrame

        local LabelObj = {}
        function LabelObj:Set(newText) Lbl.Text = newText end
        return LabelObj
    end

    -- 4. PARAGRAPH
    function API:AddParagraph(pCfg)
        local ParaFrame = Instance.new("Frame")
        ParaFrame.LayoutOrder = NextOrder()
        ParaFrame.Size = UDim2.new(1, 0, 0, 48)
        ParaFrame.AutomaticSize = Enum.AutomaticSize.Y
        ParaFrame.BackgroundColor3 = Theme.GrayTranslucent
        ParaFrame.BackgroundTransparency = 0.6
        ParaFrame.Parent = Container
        Instance.new("UICorner", ParaFrame).CornerRadius = UDim.new(0, 12)
        RegisterSearchable((pCfg.Title or "") .. " " .. (pCfg.Content or ""), ParaFrame)

        local Pad = Instance.new("UIPadding", ParaFrame)
        Pad.PaddingTop, Pad.PaddingBottom, Pad.PaddingLeft, Pad.PaddingRight = UDim.new(0, 8), UDim.new(0, 8), UDim.new(0, 10), UDim.new(0, 10)

        local List = Instance.new("UIListLayout", ParaFrame)
        List.Padding = UDim.new(0, 3)
        List.SortOrder = Enum.SortOrder.LayoutOrder

        local PTitle = Instance.new("TextLabel")
        PTitle.LayoutOrder = 1
        PTitle.Size = UDim2.new(1, 0, 0, 14)
        PTitle.BackgroundTransparency = 1
        PTitle.Text = pCfg.Title or "Title"
        PTitle.TextColor3 = Theme.Text
        PTitle.Font = Enum.Font.GothamBold
        PTitle.TextSize = 12
        PTitle.TextXAlignment = Enum.TextXAlignment.Left
        PTitle.Parent = ParaFrame

        local PBody = Instance.new("TextLabel")
        PBody.LayoutOrder = 2
        PBody.Size = UDim2.new(1, 0, 0, 0)
        PBody.AutomaticSize = Enum.AutomaticSize.Y
        PBody.BackgroundTransparency = 1
        PBody.Text = pCfg.Content or pCfg.Text or ""
        PBody.TextColor3 = Theme.SubText
        PBody.Font = Enum.Font.Gotham
        PBody.TextSize = 11
        PBody.TextWrapped = true
        PBody.TextXAlignment = Enum.TextXAlignment.Left
        PBody.Parent = ParaFrame

        local ParaObj = {}
        function ParaObj:Set(t, c)
            if t then PTitle.Text = t end
            if c then PBody.Text = c end
        end
        return ParaObj
    end

    -- 5. PROGRESS BAR (Dynamic Animated Meter)
    function API:AddProgressBar(bCfg)
        local MaxVal = bCfg.Max or 100
        local CurVal = math.clamp(bCfg.Default or 0, 0, MaxVal)

        local BarFrame = Instance.new("Frame")
        BarFrame.LayoutOrder = NextOrder()
        BarFrame.Size = UDim2.new(1, 0, 0, 42)
        BarFrame.BackgroundColor3 = Theme.Element
        BarFrame.Parent = Container
        Instance.new("UICorner", BarFrame).CornerRadius = UDim.new(0, 12)
        RegisterSearchable(bCfg.Name, BarFrame)
        AttachTooltip(BarFrame, bCfg.Tooltip)

        local Title = Instance.new("TextLabel")
        Title.Size = UDim2.new(1, -75, 0, 20)
        Title.Position = UDim2.new(0, 10, 0, 3)
        Title.BackgroundTransparency = 1
        Title.Text = bCfg.Name or "Progress"
        Title.TextColor3 = Theme.Text
        Title.Font = Enum.Font.GothamSemibold
        Title.TextSize = 12
        Title.TextXAlignment = Enum.TextXAlignment.Left
        Title.Parent = BarFrame

        local StatusLbl = Instance.new("TextLabel")
        StatusLbl.Size = UDim2.new(0, 65, 0, 20)
        StatusLbl.Position = UDim2.new(1, -75, 0, 3)
        StatusLbl.BackgroundTransparency = 1
        StatusLbl.Text = bCfg.Suffix or (tostring(math.floor((CurVal / MaxVal) * 100)) .. "%")
        StatusLbl.TextColor3 = Theme.Accent
        StatusLbl.Font = Enum.Font.GothamBold
        StatusLbl.TextSize = 11
        StatusLbl.TextXAlignment = Enum.TextXAlignment.Right
        StatusLbl.Parent = BarFrame
        BindAccent(StatusLbl, "TextColor3")

        local Track = Instance.new("Frame")
        Track.Size = UDim2.new(1, -20, 0, 7)
        Track.Position = UDim2.new(0, 10, 0, 27)
        Track.BackgroundColor3 = Theme.Background
        Track.ClipsDescendants = true
        Track.Parent = BarFrame
        Instance.new("UICorner", Track).CornerRadius = UDim.new(1, 0)

        local Fill = Instance.new("Frame")
        Fill.Size = UDim2.new(CurVal / MaxVal, 0, 1, 0)
        Fill.BackgroundColor3 = Theme.Accent
        Fill.Parent = Track
        Instance.new("UICorner", Fill).CornerRadius = UDim.new(1, 0)
        BindAccent(Fill, "BackgroundColor3")

        local BarObj = {}
        function BarObj:Set(val, customText)
            CurVal = math.clamp(val, 0, MaxVal)
            local pct = CurVal / MaxVal
            StatusLbl.Text = customText or (tostring(math.floor(pct * 100)) .. "%")
            Tween(Fill, Tweens.Smooth, {Size = UDim2.new(pct, 0, 1, 0)})
        end
        return BarObj
    end

    -- 6. BUTTON (Supports Icon, Sound, Tooltip & Cooldown)
    function API:AddButton(bCfg)
        local Callback = bCfg.Callback or function() end
        local CooldownTime = bCfg.Cooldown or 0
        local OnCooldown = false
        local hasIcon = bCfg.Icon ~= nil and tostring(bCfg.Icon) ~= ""

        local Btn = Instance.new("TextButton")
        Btn.LayoutOrder = NextOrder()
        Btn.Size = UDim2.new(1, 0, 0, 32)
        Btn.BackgroundColor3 = Theme.Element
        Btn.Text = ""
        Btn.AutoButtonColor = false
        Btn.ClipsDescendants = true
        Btn.Parent = Container
        Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 12)
        RegisterSearchable(bCfg.Name, Btn)
        AttachTooltip(Btn, bCfg.Tooltip)

        local CdOverlay = Instance.new("Frame")
        CdOverlay.Size = UDim2.new(0, 0, 1, 0)
        CdOverlay.BackgroundColor3 = Theme.Accent
        CdOverlay.BackgroundTransparency = 0.8
        CdOverlay.BorderSizePixel = 0
        CdOverlay.ZIndex = 1
        CdOverlay.Parent = Btn
        BindAccent(CdOverlay, "BackgroundColor3")

        if hasIcon then CreateIcon(Btn, bCfg.Icon, 15, UDim2.new(0, 10, 0.5, -7.5), 3) end

        local Title = Instance.new("TextLabel")
        Title.Size = UDim2.new(1, hasIcon and -48 or -34, 1, 0)
        Title.Position = UDim2.new(0, hasIcon and 30 or 10, 0, 0)
        Title.BackgroundTransparency = 1
        Title.Text = bCfg.Name or "Button"
        Title.TextColor3 = Theme.Text
        Title.Font = Enum.Font.GothamSemibold
        Title.TextSize = 12
        Title.TextXAlignment = Enum.TextXAlignment.Left
        Title.ZIndex = 3
        Title.Parent = Btn

        local ArrowHint = Instance.new("TextLabel")
        ArrowHint.Size = UDim2.new(0, 18, 0, 18)
        ArrowHint.Position = UDim2.new(1, -24, 0.5, -9)
        ArrowHint.BackgroundTransparency = 1
        ArrowHint.Text = "›"
        ArrowHint.TextColor3 = Theme.SubText
        ArrowHint.Font = Enum.Font.GothamBold
        ArrowHint.TextSize = 15
        ArrowHint.ZIndex = 3
        ArrowHint.Parent = Btn

        Btn.MouseEnter:Connect(function()
            if OnCooldown then return end
            TryxzLib:PlaySound("Hover", 0.2)
            Tween(Btn, Tweens.Fast, {BackgroundColor3 = Theme.ElementHover})
            Tween(ArrowHint, Tweens.Fast, {Position = UDim2.new(1, -21, 0.5, -9), TextColor3 = Theme.Accent})
        end)
        Btn.MouseLeave:Connect(function()
            Tween(Btn, Tweens.Fast, {BackgroundColor3 = Theme.Element})
            Tween(ArrowHint, Tweens.Fast, {Position = UDim2.new(1, -24, 0.5, -9), TextColor3 = Theme.SubText})
        end)
        Btn.MouseButton1Click:Connect(function()
            if OnCooldown then
                TryxzLib:PlaySound("Error", 0.25)
                return
            end
            TriggerHaptic(0.3)
            TryxzLib:PlaySound(bCfg.Sound or "Click")
            Tween(Btn, TweenInfo.new(0.08, Enum.EasingStyle.Quad), {BackgroundColor3 = Theme.Accent})
            task.delay(0.1, function() Tween(Btn, Tweens.Fast, {BackgroundColor3 = Theme.Element}) end)
            task.spawn(Callback)

            if CooldownTime > 0 then
                OnCooldown = true
                CdOverlay.Size = UDim2.new(1, 0, 1, 0)
                local cdTween = Tween(CdOverlay, TweenInfo.new(CooldownTime, Enum.EasingStyle.Linear), {Size = UDim2.new(0, 0, 1, 0)})
                cdTween.Completed:Wait()
                OnCooldown = false
            end
        end)
    end

    -- 7. TOGGLE
    function API:AddToggle(tCfg)
        local Flag = tCfg.Flag
        local StateVal = tCfg.Default or false
        local Callback = tCfg.Callback or function() end
        local hasIcon = tCfg.Icon ~= nil and tostring(tCfg.Icon) ~= ""

        if Cfg.SaveEnabled and Flag and Cfg.SavedData[Flag] ~= nil then
            StateVal = Cfg.SavedData[Flag]
        end

        local ToggleBtn = Instance.new("TextButton")
        ToggleBtn.LayoutOrder = NextOrder()
