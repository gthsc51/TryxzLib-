local function AttachParticleCanvas(parentFrame, count, customColorA, customColorB)
    local canvas = Instance.new("Frame")
    canvas.Name = "ParticleCanvas"
    canvas.Size = UDim2.new(1, 0, 1, 0)
    canvas.BackgroundTransparency = 1
    canvas.ClipsDescendants = true
    canvas.ZIndex = (parentFrame.ZIndex or 1) + 1
    canvas.Parent = parentFrame

    local particles = {}
    for i = 1, (count or 18) do
        local sz = math.random(2, 4)
        local dot = Instance.new("Frame")
        dot.Size = UDim2.new(0, sz, 0, sz)
        dot.Position = UDim2.new(math.random() * 0.95, 0, math.random() * 0.95, 0)
        if customColorA then
            dot.BackgroundColor3 = (i % 2 == 0) and customColorA or (customColorB or customColorA)
        else
            dot.BackgroundColor3 = (i % 2 == 0) and Theme.Accent or (Theme.AccentSecondary or Theme.Accent)
            BindTheme(dot, "BackgroundColor3", (i % 2 == 0) and "Accent" or "AccentSecondary")
        end
        dot.BackgroundTransparency = math.random(50, 80) / 100
        dot.BorderSizePixel = 0
        dot.ZIndex = canvas.ZIndex
        dot.Parent = canvas
        Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

        table.insert(particles, {
            Obj = dot,
            X = dot.Position.X.Scale,
            Y = dot.Position.Y.Scale,
            VX = (math.random(-10, 10) / 1000),
            VY = -(math.random(6, 18) / 1000)
        })
    end

    RunService.RenderStepped:Connect(function(dt)
        if not canvas.Parent or not parentFrame.Visible then return end
        for _, p in ipairs(particles) do
            p.X += p.VX * dt * 2.5
            p.Y += p.VY * dt * 2.5
            if p.Y < -0.04 then
                p.Y = 1.04
                p.X = math.random() * 0.95
            end
            if p.X < 0 then p.X = 1 elseif p.X > 1 then p.X = 0 end
            p.Obj.Position = UDim2.new(p.X, 0, p.Y, 0)
        end
    end)
end

