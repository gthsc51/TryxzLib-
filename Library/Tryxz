local function BindAccent(obj, prop, conditionFn)
    table.insert(AccentObjects, {Obj = obj, Prop = prop, Cond = conditionFn})
end

function TryxzLib:SetAccent(newColor)
    Theme.Accent = newColor
    local h, s, v = newColor:ToHSV()
    Theme.AccentHover = Color3.fromHSV(h, math.max(0, s - 0.08), math.min(1, v + 0.08))

    for i = #AccentObjects, 1, -1 do
        local entry = AccentObjects[i]
        if entry.Obj and entry.Obj.Parent then
            if not entry.Cond or entry.Cond() then
                Tween(entry.Obj, Tweens.Fast, {[entry.Prop] = newColor})
            end
        else
            table.remove(AccentObjects, i)
        end
    end
end

