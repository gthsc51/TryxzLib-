                OptBtn.MouseEnter:Connect(function() Tween(OptBtn, Tweens.Fast, {BackgroundColor3 = Theme.ElementHover, TextColor3 = Theme.Text}) end)
                OptBtn.MouseLeave:Connect(function() Tween(OptBtn, Tweens.Fast, {BackgroundColor3 = Theme.Background, TextColor3 = Theme.SubText}) end)
                OptBtn.MouseButton1Click:Connect(function()
                    SelectedLbl.Text = tostring(opt)
                    if Flag then
                        SavedData[Flag] = opt
                        WriteConfigFile()
                    end
                    ToggleDrop()
                    task.spawn(Callback, opt)
                end)
            end

            if SaveEnabled and Flag and SavedData[Flag] ~= nil then
                task.spawn(Callback, Default)
            end
        end

        -- 9. MULTI-DROPDOWN (Supports Flag for SaveConfig)
        function TabAPI:AddMultiDropdown(config)
            local Name = config.Name or "MultiDropdown"
            local Flag = config.Flag
            local Options = config.Options or {}
            local Selected = {}
            local Callback = config.Callback or function() end
            local Open = false

            if SaveEnabled and Flag and type(SavedData[Flag]) == "table" then
                for _, v in ipairs(SavedData[Flag]) do
                    Selected[v] = true
                end
            elseif config.Default then
                for _, v in ipairs(config.Default) do
                    Selected[v] = true
                end
            end

            local DropFrame = Instance.new("Frame")
            DropFrame.LayoutOrder = NextOrder()
            DropFrame.Size = UDim2.new(1, 0, 0, 32)
            DropFrame.BackgroundColor3 = Theme.Element
            DropFrame.ClipsDescendants = true
            DropFrame.Parent = Page
            Instance.new("UICorner", DropFrame).CornerRadius = UDim.new(0, 12)

            local Header = Instance.new("TextButton")
            Header.Size = UDim2.new(1, 0, 0, 32)
            Header.BackgroundTransparency = 1
            Header.Text = ""
            Header.Parent = DropFrame

            local Title = Instance.new("TextLabel")
            Title.Size = UDim2.new(0.45, 0, 1, 0)
            Title.Position = UDim2.new(0, 10, 0, 0)
            Title.BackgroundTransparency = 1
            Title.Text = Name
            Title.TextColor3 = Theme.Text
            Title.Font = Enum.Font.GothamSemibold
            Title.TextSize = 12
            Title.TextXAlignment = Enum.TextXAlignment.Left
            Title.Parent = Header

            local SelectedLbl = Instance.new("TextLabel")
            SelectedLbl.Size = UDim2.new(0.55, -30, 1, 0)
            SelectedLbl.Position = UDim2.new(0.45, 0, 0, 0)
            SelectedLbl.BackgroundTransparency = 1
            SelectedLbl.Text = "None"
            SelectedLbl.TextColor3 = Theme.Accent
            SelectedLbl.Font = Enum.Font.Gotham
            SelectedLbl.TextSize = 11
            SelectedLbl.TextXAlignment = Enum.TextXAlignment.Right
            SelectedLbl.TextTruncate = Enum.TextTruncate.AtEnd
            SelectedLbl.Parent = Header

            local Arrow = Instance.new("TextLabel")
            Arrow.Size = UDim2.new(0, 18, 0, 18)
            Arrow.Position = UDim2.new(1, -24, 0.5, -9)
            Arrow.BackgroundTransparency = 1
            Arrow.Text = "▼"
            Arrow.TextColor3 = Theme.SubText
            Arrow.Font = Enum.Font.GothamBold
            Arrow.TextSize = 9
            Arrow.Parent = Header

            local ListHolder = Instance.new("Frame")
            ListHolder.Size = UDim2.new(1, -12, 0, 0)
            ListHolder.Position = UDim2.new(0, 6, 0, 34)
            ListHolder.BackgroundTransparency = 1
            ListHolder.Parent = DropFrame

            local ListLayout = Instance.new("UIListLayout", ListHolder)
            ListLayout.Padding = UDim.new(0, 4)
            ListLayout.SortOrder = Enum.SortOrder.LayoutOrder

            local function UpdateSummary(shouldSave)
                local activeList = {}
                for k, v in pairs(Selected) do
                    if v then table.insert(activeList, tostring(k)) end
                end
                SelectedLbl.Text = #activeList > 0 and table.concat(activeList, ", ") or "None"
                if shouldSave and Flag then
                    SavedData[Flag] = activeList
                    WriteConfigFile()
                end
                task.spawn(Callback, activeList)
            end

            Header.MouseButton1Click:Connect(function()
                TriggerHaptic(0.2)
                tryxzlib:PlaySound("Click")
                Open = not Open
                local totalHeight = Open and (38 + (#Options * 26)) or 32
                Tween(DropFrame, Tweens.Smooth, {Size = UDim2.new(1, 0, 0, totalHeight)})
                Tween(Arrow, Tweens.Smooth, {Rotation = Open and 180 or 0})
            end)

            for i, opt in ipairs(Options) do
                local OptBtn = Instance.new("TextButton")
                OptBtn.LayoutOrder = i
                OptBtn.Size = UDim2.new(1, 0, 0, 22)
                OptBtn.BackgroundColor3 = Selected[opt] and Theme.Accent or Theme.Background
                OptBtn.Text = "  " .. tostring(opt)
                OptBtn.TextColor3 = Selected[opt] and Theme.Text or Theme.SubText
                OptBtn.Font = Enum.Font.Gotham
                OptBtn.TextSize = 11
                OptBtn.TextXAlignment = Enum.TextXAlignment.Left
                OptBtn.AutoButtonColor = false
                OptBtn.Parent = ListHolder
                Instance.new("UICorner", OptBtn).CornerRadius = UDim.new(0, 9)

                OptBtn.MouseButton1Click:Connect(function()
                    TriggerHaptic(0.25)
                    tryxzlib:PlaySound("Toggle")
                    Selected[opt] = not Selected[opt]
                    Tween(OptBtn, Tweens.Fast, {
                        BackgroundColor3 = Selected[opt] and Theme.Accent or Theme.Background,
                        TextColor3 = Selected[opt] and Theme.Text or Theme.SubText
                    })
                    UpdateSummary(true)
                end)
            end

            UpdateSummary(false)
        end

        return TabAPI
    end

    return Window
end

return tryxzlib
