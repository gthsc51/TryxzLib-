function tryxzlib:CreateWindow(config)
    config = config or {}
    local Cfg = {
        Title = config.Title or "tryxzlib",
        Subtitle = config.Subtitle or "",
        Icon = config.Icon,
        Profile = config.Profile ~= false,
        Stats = config.Stats ~= false,
        Keybind = config.ToggleKey or Enum.KeyCode.RightControl,
        Haptics = config.Haptics ~= false,
        SaveEnabled = false,
        SaveFolder = "TryxzLibConfigs",
        SaveFile = "",
        SavedData = {},
        HasExistingSave = false,
        WinW = 465,
        WinH = 305,
        TopH = 44,
        SideW = 128
    }

    local State = {
        Minimized = false,
        Collapsed = false,
        Hidden = false,
        SettingsOpen = false
    }

    -- Setup SaveConfig
    if type(config.SaveConfig) == "boolean" then
        Cfg.SaveEnabled = config.SaveConfig
    elseif type(config.SaveConfig) == "table" then
        Cfg.SaveEnabled = config.SaveConfig.Enabled ~= false
        if config.SaveConfig.Folder then Cfg.SaveFolder = config.SaveConfig.Folder end
    end
    local fName = (type(config.SaveConfig) == "table" and config.SaveConfig.FileName) or tostring(Cfg.Title):gsub("[^%w_-]", "_")
    Cfg.SaveFile = Cfg.SaveFolder .. "/" .. fName .. ".json"

    local function WriteConfigFile()
        if not Cfg.SaveEnabled then return end
        pcall(function()
            if makefolder and isfolder and not isfolder(Cfg.SaveFolder) then makefolder(Cfg.SaveFolder) end
            if writefile then
                Cfg.SavedData["_Haptics"] = Cfg.Haptics
                Cfg.SavedData["_Sounds"] = SoundConfig.Enabled
                writefile(Cfg.SaveFile, HttpService:JSONEncode(Cfg.SavedData))
            end
        end)
    end

    if Cfg.SaveEnabled then
        pcall(function()
            if isfile and readfile and isfile(Cfg.SaveFile) then
                local decoded = HttpService:JSONDecode(readfile(Cfg.SaveFile))
                if type(decoded) == "table" then
                    Cfg.SavedData = decoded
                    Cfg.HasExistingSave = true
                    if decoded["_Haptics"] ~= nil then Cfg.Haptics = decoded["_Haptics"] end
                    if decoded["_Sounds"] ~= nil then SoundConfig.Enabled = decoded["_Sounds"] end
                end
            end
        end)
    end

    if type(config.Sounds) == "boolean" then
        if not Cfg.HasExistingSave then SoundConfig.Enabled = config.Sounds end
    elseif type(config.Sounds) == "table" then
        if config.Sounds.Enabled ~= nil and not Cfg.HasExistingSave then SoundConfig.Enabled = config.Sounds.Enabled end
        if config.Sounds.Volume ~= nil then SoundConfig.Volume = config.Sounds.Volume end
        for k, v in pairs(config.Sounds) do
            if SoundConfig[k] ~= nil and k ~= "Enabled" and k ~= "Volume" then SoundConfig[k] = v end
        end
    end

    local function TriggerHaptic(strength)
        if not Cfg.Haptics then return end
        pcall(function()
            HapticService:SetMotor(Enum.UserInputType.Gamepad1, Enum.VibrationMotor.Small, strength or 0.35)
            task.delay(0.06, function()
                HapticService:SetMotor(Enum.UserInputType.Gamepad1, Enum.VibrationMotor.Small, 0)
            end)
        end)
    end

    -- Main Frame
    local Main = Instance.new("Frame")
    Main.Name = "MainWindow"
    Main.Size = UDim2.new(0, 0, 0, 0)
    Main.Position = UDim2.new(0.5, -Cfg.WinW/2, 0.5, -Cfg.WinH/2)
    Main.BackgroundColor3 = Theme.Sidebar
    Main.BorderSizePixel = 0
    Main.ClipsDescendants = true
    Main.Visible = false
    Main.Parent = ScreenGui
    Instance.new("UICorner", Main).CornerRadius = UDim.new(0, 18)

    local MainStroke = Instance.new("UIStroke", Main)
    MainStroke.Color = Theme.Divider
    MainStroke.Thickness = 1.2
    MainStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

    -- Floating UI Button
    local FloatingUIBtn = Instance.new("TextButton")
    FloatingUIBtn.Name = "FloatingUIButton"
    FloatingUIBtn.Size = UDim2.new(0, 0, 0, 0)
    FloatingUIBtn.Position = UDim2.new(0, 18, 0, 70)
    FloatingUIBtn.BackgroundColor3 = Theme.Sidebar
