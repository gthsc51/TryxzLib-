                end
                ListeningEntry = entry
                KeyBadgeBtn.Text = "..."
                KeyBadgeBtn.TextColor3 = Theme.Success
            end
        end)

        table.insert(BindableEntries, entry)
        Window.Keybinds = Window.Keybinds or {}
