local function Tween(obj, info, props)
    local t = TweenService:Create(obj, info, props)
    t:Play()
    return t
end

local function BindTheme(obj, prop, themeKey, conditionFn)
    table.insert(ThemeBindings, {Obj = obj, Prop = prop, Key = themeKey, Cond = conditionFn})
end

local function BindAccent(obj, prop, conditionFn)
    BindTheme(obj, prop, "Accent", conditionFn)
end

local function ApplyAccentGradient(parent, rotation, animatedSpin)
    local grad = Instance.new("UIGradient")
    grad.Rotation = rotation or 0
    grad.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Theme.Accent),
        ColorSequenceKeypoint.new(0.5, Theme.AccentSecondary or Theme.Accent),
        ColorSequenceKeypoint.new(1, Theme.Accent)
    }
    grad.Parent = parent
    table.insert(GradientBindings, grad)
    if animatedSpin then
        table.insert(AnimatedGradientBorders, grad)
    end
    return grad
end

RunService.RenderStepped:Connect(function(dt)
    for i = #AnimatedGradientBorders, 1, -1 do
        local g = AnimatedGradientBorders[i]
        if g and g.Parent then
            g.Rotation = (g.Rotation + dt * 55) % 360
        else
            table.remove(AnimatedGradientBorders, i)
        end
    end
end)

