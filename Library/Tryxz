local BlurState = {
    Enabled = true,
    TargetSize = 14,
    Instance = nil
}

local function GetOrCreateBlur()
    if BlurState.Instance and BlurState.Instance.Parent then
        return BlurState.Instance
    end
    local existing = Lighting:FindFirstChild("TryxzLib_Blur")
    if existing then existing:Destroy() end

    local blur = Instance.new("BlurEffect")
    blur.Name = "TryxzLib_Blur"
    blur.Size = 0
    blur.Enabled = false
    blur.Parent = Lighting
    BlurState.Instance = blur
    return blur
end

local function SetBlurActive(active)
    local blur = GetOrCreateBlur()
    if active and BlurState.Enabled then
        blur.Enabled = true
        Tween(blur, Tweens.Smooth, {Size = BlurState.TargetSize})
    else
        local t = Tween(blur, Tweens.Fast, {Size = 0})
        t.Completed:Connect(function()
            if blur and blur.Size <= 0.1 then
                blur.Enabled = false
            end
        end)
    end
end

local function DestroyBlur()
    if BlurState.Instance then
        BlurState.Instance:Destroy()
        BlurState.Instance = nil
    end
end

