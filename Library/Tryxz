            local function UpdateToggle(val, silent)
                State = val
                if Flag then
                    SavedData[Flag] = State
                    WriteConfigFile()
                end
                if not silent then
                    TriggerHaptic(0.28)
                    tryxzlib:PlaySound(CustomSound)
                end
                Tween(SwitchBg, Tweens.Fast, {BackgroundColor3 = State and Theme.Accent or Theme.Background})
                Tween(Knob, Tweens.Bounce, {Position = State and UDim2.new(1, -15, 0.5, -6) or UDim2.new(0, 3, 0.5, -6)})
                task.spawn(Callback, State)
            end

            ToggleBtn.MouseEnter:Connect(function() Tween(ToggleBtn, Tweens.Fast, {BackgroundColor3 = Theme.ElementHover}) end)
            ToggleBtn.MouseLeave:Connect(function() Tween(ToggleBtn, Tweens.Fast, {BackgroundColor3 = Theme.Element}) end)
            ToggleBtn.MouseButton1Click:Connect(function() UpdateToggle(not State, false) end)

            if State then task.spawn(Callback, true) end

            local ToggleObj = {}
            function ToggleObj:Set(val) UpdateToggle(val, true) end
            if Flag then RegisteredFlags[Flag] = ToggleObj end
            return ToggleObj
        end

        -- 7. SLIDERS (Supports Flag for SaveConfig)
        function TabAPI:AddSlider(config)
            local Name = config.Name or "Slider"
            local Flag = config.Flag
            local Min = config.Min or 0
            local Max = config.Max or 100
            local Default = math.clamp(config.Default or Min, Min, Max)
            local Callback = config.Callback or function() end

            if SaveEnabled and Flag and SavedData[Flag] ~= nil then
                Default = math.clamp(tonumber(SavedData[Flag]) or Default, Min, Max)
            end

            local SliderFrame = Instance.new("Frame")
            SliderFrame.LayoutOrder = NextOrder()
            SliderFrame.Size = UDim2.new(1, 0, 0, 42)
            SliderFrame.BackgroundColor3 = Theme.Element
            SliderFrame.Parent = Page
            Instance.new("UICorner", SliderFrame).CornerRadius = UDim.new(0, 12)

            local Title = Instance.new("TextLabel")
            Title.Size = UDim2.new(1, -60, 0, 20)
            Title.Position = UDim2.new(0, 10, 0, 3)
            Title.BackgroundTransparency = 1
