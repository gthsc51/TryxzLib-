        ListLayout.Padding = UDim.new(0, 4)
        ListLayout.SortOrder = Enum.SortOrder.LayoutOrder

        local VisibleCount = #Options
        local function GetOpenHeight()
            local rowsH = math.min(VisibleCount, 6) * 26
            return 40 + searchOffset + math.max(26, rowsH)
        end

        local function ToggleDrop()
            TriggerHaptic(0.2)
            TryxzLib:PlaySound("Click")
            Open = not Open
            Tween(DropFrame, Tweens.Smooth, {Size = UDim2.new(1, 0, 0, Open and GetOpenHeight() or 34)})
            Tween(DStroke, Tweens.Fast, {Color = Open and Theme.Accent or Theme.Divider, Transparency = Open and 0.2 or 0.5})
            Tween(Arrow, Tweens.Smooth, {Rotation = Open and 180 or 0})
        end

        Header.MouseButton1Click:Connect(ToggleDrop)

        local OptEntries = {}
        local function RebuildOptions(newOpts, newIcons)
            for _, child in ipairs(ListHolder:GetChildren()) do
                if child:IsA("TextButton") then child:Destroy() end
            end
            OptEntries = {}
            Options = newOpts or Options
            OptIcons = newIcons or OptIcons
            VisibleCount = #Options

            for i, opt in ipairs(Options) do
                local optIcon = OptIcons[opt] or OptIcons[tostring(opt)] or (type(opt) == "table" and opt.Icon)
                local optLabel = type(opt) == "table" and tostring(opt.Text or opt.Name or opt.Value or "Option") or tostring(opt)
                local optValue = type(opt) == "table" and (opt.Value or optLabel) or opt

                local OptBtn = Instance.new("TextButton")
                OptBtn.LayoutOrder = i
                OptBtn.Size = UDim2.new(1, 0, 0, 22)
                OptBtn.BackgroundColor3 = Theme.Background
                OptBtn.Text = ""
