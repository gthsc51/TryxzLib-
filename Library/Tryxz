        Title.BackgroundTransparency = 1
        Title.Text = sCfg.Name or "Slider"
        Title.TextColor3 = Theme.Text
        Title.Font = Enum.Font.GothamSemibold
        Title.TextSize = 12
        Title.TextXAlignment = Enum.TextXAlignment.Left
        Title.Parent = SliderFrame
        BindTheme(Title, "TextColor3", "Text")

        local ValPill = Instance.new("Frame")
        ValPill.Size = UDim2.new(0, 50, 0, 17)
        ValPill.Position = UDim2.new(1, -60, 0, 6)
        ValPill.BackgroundColor3 = Theme.Background
        ValPill.Parent = SliderFrame
        Instance.new("UICorner", ValPill).CornerRadius = UDim.new(1, 0)
        BindTheme(ValPill, "BackgroundColor3", "Background")

        local ValueLbl = Instance.new("TextLabel")
        ValueLbl.Size = UDim2.new(1, 0, 1, 0)
        ValueLbl.BackgroundTransparency = 1
        ValueLbl.Text = tostring(Default)
        ValueLbl.TextColor3 = Theme.Accent
        ValueLbl.Font = Enum.Font.GothamBold
        ValueLbl.TextSize = 11
        ValueLbl.Parent = ValPill
        BindAccent(ValueLbl, "TextColor3")

        local Track = Instance.new("TextButton")
        Track.Size = UDim2.new(1, -22, 0, 6)
        Track.Position = UDim2.new(0, 11, 0, 31)
        Track.BackgroundColor3 = Theme.Background
        Track.Text = ""
        Track.AutoButtonColor = false
        Track.Parent = SliderFrame
        Instance.new("UICorner", Track).CornerRadius = UDim.new(1, 0)
        BindTheme(Track, "BackgroundColor3", "Background")

        local Fill = Instance.new("Frame")
        Fill.Size = UDim2.new((Default - Min) / (Max - Min), 0, 1, 0)
        Fill.BackgroundColor3 = Color3.new(1, 1, 1)
        Fill.Parent = Track
        Instance.new("UICorner", Fill).CornerRadius = UDim.new(1, 0)
        ApplyAccentGradient(Fill, 0)

        local Dot = Instance.new("Frame")
        Dot.Size = UDim2.new(0, 13, 0, 13)
        Dot.Position = UDim2.new(1, 0, 0.5, 0)
        Dot.AnchorPoint = Vector2.new(0.5, 0.5)
        Dot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        Dot.Parent = Fill
        Instance.new("UICorner", Dot).CornerRadius = UDim.new(1, 0)

        local DotRing = Instance.new("UIStroke", Dot)
        DotRing.Color = Theme.Accent
        DotRing.Thickness = 2
        BindAccent(DotRing, "Color")

        local Sliding, lastVal = false, Default
        local function SetSlider(val, silent, saveNow)
            val = math.clamp(math.floor(val + 0.5), Min, Max)
            CurrentVal = val
            if val ~= lastVal then
                lastVal = val
                if not silent then TriggerHaptic(0.12) TryxzLib:PlaySound("Hover", 0.15) end
            end
            if Flag then Cfg.SavedData[Flag] = val end
            if saveNow then WriteConfigFile() end
            ValueLbl.Text = tostring(val)
            Tween(Fill, TweenInfo.new(0.08, Enum.EasingStyle.Quad), {Size = UDim2.new((val - Min) / (Max - Min), 0, 1, 0)})
            task.spawn(Callback, val)
        end

        local function UpdateFromInput(input)
            local pos = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
            SetSlider(Min + (Max - Min) * pos, false, false)
        end

        Track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                Sliding = true
                Tween(Dot, Tweens.Fast, {Size = UDim2.new(0, 16, 0, 16)})
                Tween(SStroke, Tweens.Fast, {Color = Theme.Accent, Transparency = 0.2})
                UpdateFromInput(input)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if Sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                UpdateFromInput(input)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and Sliding then
                Sliding = false
                WriteConfigFile()
                Tween(Dot, Tweens.Fast, {Size = UDim2.new(0, 13, 0, 13)})
                Tween(SStroke, Tweens.Fast, {Color = Theme.Divider, Transparency = 0.5})
            end
        end)

        task.spawn(Callback, Default)

        local SliderObj = WrapElementControls(SliderFrame, sCfg)
        function SliderObj:Set(val, skipWrite) SetSlider(val, true, not skipWrite) end
        function SliderObj:Get() return CurrentVal end
        if Flag then Window.Flags[Flag] = SliderObj end

        if RegisterBindable and sCfg.Bindable ~= false then
            RegisterBindable({
                Id = Flag or ("Sld_" .. tostring(sCfg.Name or "Slider")),
                Name = (sCfg.Name or "Slider") .. " (+" .. tostring(StepVal) .. ")",
                Kind = "Slider",
                DefaultKey = sCfg.Keybind,
                Trigger = function()
                    local nextVal = CurrentVal + StepVal
                    if nextVal > Max then nextVal = Min end
                    SetSlider(nextVal, false, true)
                end
            })
        end

        return SliderObj
    end

