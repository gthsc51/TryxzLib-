            OptBtn.TextColor3 = Theme.SubText
            OptBtn.Font = Enum.Font.Gotham
            OptBtn.TextSize = 11
            OptBtn.TextXAlignment = Enum.TextXAlignment.Left
            OptBtn.AutoButtonColor = false
            OptBtn.Parent = ListHolder
            Instance.new("UICorner", OptBtn).CornerRadius = UDim.new(0, 9)

            OptBtn.MouseEnter:Connect(function() Tween(OptBtn, Tweens.Fast, {BackgroundColor3 = Theme.ElementHover, TextColor3 = Theme.Text}) end)
            OptBtn.MouseLeave:Connect(function() Tween(OptBtn, Tweens.Fast, {BackgroundColor3 = Theme.Background, TextColor3 = Theme.SubText}) end)
            OptBtn.MouseButton1Click:Connect(function()
                SelectedLbl.Text = tostring(opt)
                if Flag then Cfg.SavedData[Flag] = opt WriteConfigFile() end
                ToggleDrop()
                task.spawn(Callback, opt)
            end)
        end

        if Cfg.SaveEnabled and Flag and Cfg.SavedData[Flag] ~= nil then task.spawn(Callback, Default) end

        local DropObj = {}
        function DropObj:Set(val, skipWrite)
            SelectedLbl.Text = tostring(val)
            if Flag and not skipWrite then Cfg.SavedData[Flag] = val WriteConfigFile() end
            task.spawn(Callback, val)
        end
        if Flag then Window.Flags[Flag] = DropObj end
        return DropObj
    end

    -- 13. MULTI-DROPDOWN
    function API:AddMultiDropdown(mCfg)
        local Flag = mCfg.Flag
        local Options = mCfg.Options or {}
        local Selected = {}
        local Callback = mCfg.Callback or function() end
        local Open = false

        if Cfg.SaveEnabled and Flag and type(Cfg.SavedData[Flag]) == "table" then
            for _, v in ipairs(Cfg.SavedData[Flag]) do Selected[v] = true end
        elseif mCfg.Default then
            for _, v in ipairs(mCfg.Default) do Selected[v] = true end
        end

        local DropFrame = Instance.new("Frame")
        DropFrame.LayoutOrder = NextOrder()
        DropFrame.Size = UDim2.new(1, 0, 0, 32)
        DropFrame.BackgroundColor3 = Theme.Element
        DropFrame.ClipsDescendants = true
        DropFrame.Parent = Container
        Instance.new("UICorner", DropFrame).CornerRadius = UDim.new(0, 12)
        RegisterSearchable(mCfg.Name, DropFrame)
        AttachTooltip(DropFrame, mCfg.Tooltip)

        local Header = Instance.new("TextButton")
        Header.Size = UDim2.new(1, 0, 0, 32)
        Header.BackgroundTransparency = 1
        Header.Text = ""
        Header.Parent = DropFrame

        local Title = Instance.new("TextLabel")
        Title.Size = UDim2.new(0.45, 0, 1, 0)
        Title.Position = UDim2.new(0, 10, 0, 0)
        Title.BackgroundTransparency = 1
        Title.Text = mCfg.Name or "MultiDropdown"
        Title.TextColor3 = Theme.Text
        Title.Font = Enum.Font.GothamSemibold
        Title.TextSize = 12
        Title.TextXAlignment = Enum.TextXAlignment.Left
        Title.Parent = Header

        local SelectedLbl = Instance.new("TextLabel")
        SelectedLbl.Size = UDim2.new(0.55, -30, 1, 0)
        SelectedLbl.Position = UDim2.new(0.45, 0, 0, 0)
        SelectedLbl.BackgroundTransparency = 1
        SelectedLbl.Text = "None"
        SelectedLbl.TextColor3 = Theme.Accent
        SelectedLbl.Font = Enum.Font.Gotham
        SelectedLbl.TextSize = 11
        SelectedLbl.TextXAlignment = Enum.TextXAlignment.Right
        SelectedLbl.TextTruncate = Enum.TextTruncate.AtEnd
        SelectedLbl.Parent = Header
        BindAccent(SelectedLbl, "TextColor3")

        local Arrow = Instance.new("TextLabel")
        Arrow.Size = UDim2.new(0, 18, 0, 18)
        Arrow.Position = UDim2.new(1, -24, 0.5, -9)
        Arrow.BackgroundTransparency = 1
        Arrow.Text = "▼"
        Arrow.TextColor3 = Theme.SubText
        Arrow.Font = Enum.Font.GothamBold
        Arrow.TextSize = 9
        Arrow.Parent = Header

        local ListHolder = Instance.new("Frame")
        ListHolder.Size = UDim2.new(1, -12, 0, 0)
        ListHolder.Position = UDim2.new(0, 6, 0, 34)
        ListHolder.BackgroundTransparency = 1
        ListHolder.Parent = DropFrame

        local ListLayout = Instance.new("UIListLayout", ListHolder)
        ListLayout.Padding = UDim.new(0, 4)
        ListLayout.SortOrder = Enum.SortOrder.LayoutOrder

        local function UpdateSummary(shouldSave)
            local activeList = {}
            for k, v in pairs(Selected) do
                if v then table.insert(activeList, tostring(k)) end
            end
            SelectedLbl.Text = #activeList > 0 and table.concat(activeList, ", ") or "None"
            if shouldSave and Flag then Cfg.SavedData[Flag] = activeList WriteConfigFile() end
            task.spawn(Callback, activeList)
        end

        Header.MouseButton1Click:Connect(function()
            TriggerHaptic(0.2)
            TryxzLib:PlaySound("Click")
            Open = not Open
            Tween(DropFrame, Tweens.Smooth, {Size = UDim2.new(1, 0, 0, Open and (38 + (#Options * 26)) or 32)})
            Tween(Arrow, Tweens.Smooth, {Rotation = Open and 180 or 0})
        end)

        local OptButtons = {}
        for i, opt in ipairs(Options) do
            local OptBtn = Instance.new("TextButton")
            OptBtn.LayoutOrder = i
            OptBtn.Size = UDim2.new(1, 0, 0, 22)
            OptBtn.BackgroundColor3 = Selected[opt] and Theme.Accent or Theme.Background
            OptBtn.Text = "  " .. tostring(opt)
            OptBtn.TextColor3 = Selected[opt] and Theme.Text or Theme.SubText
            OptBtn.Font = Enum.Font.Gotham
            OptBtn.TextSize = 11
            OptBtn.TextXAlignment = Enum.TextXAlignment.Left
            OptBtn.AutoButtonColor = false
            OptBtn.Parent = ListHolder
            Instance.new("UICorner", OptBtn).CornerRadius = UDim.new(0, 9)
            BindAccent(OptBtn, "BackgroundColor3", function() return Selected[opt] end)
            OptButtons[opt] = OptBtn

            OptBtn.MouseButton1Click:Connect(function()
                TriggerHaptic(0.25)
                TryxzLib:PlaySound("Toggle")
                Selected[opt] = not Selected[opt]
                Tween(OptBtn, Tweens.Fast, {
                    BackgroundColor3 = Selected[opt] and Theme.Accent or Theme.Background,
                    TextColor3 = Selected[opt] and Theme.Text or Theme.SubText
                })
                UpdateSummary(true)
            end)
        end

        UpdateSummary(false)

        local MultiObj = {}
        function MultiObj:Set(listTbl, skipWrite)
            Selected = {}
            if type(listTbl) == "table" then
                for _, v in ipairs(listTbl) do Selected[v] = true end
            end
            for opt, btn in pairs(OptButtons) do
                btn.BackgroundColor3 = Selected[opt] and Theme.Accent or Theme.Background
                btn.TextColor3 = Selected[opt] and Theme.Text or Theme.SubText
            end
            UpdateSummary(not skipWrite)
        end
        if Flag then Window.Flags[Flag] = MultiObj end
        return MultiObj
    end

    return API
end

-- ==========================================
-- CREATE MAIN WINDOW (WITH MULTI-PROFILE CONFIG MANAGER & UI SCALE)
-- ==========================================
function TryxzLib:CreateWindow(config)
    config = config or {}
    local Cfg = {
        Title = config.Title or "TryxzLib",
        Subtitle = config.Subtitle or "",
        Icon = config.Icon,
        Profile = config.Profile ~= false,
        Stats = config.Stats ~= false,
        SearchBar = config.SearchBar ~= false,
        Keybind = config.ToggleKey or Enum.KeyCode.RightControl,
        Haptics = config.Haptics ~= false,
        UIScale = 1,
        SaveEnabled = false,
        SaveKey = false,
        SavedKey = nil,
        SaveFolder = "TryxzLibConfigs",
        ActiveProfile = "default",
        SaveFile = "",
        SavedData = {},
        HasExistingSave = false,
        WinW = 475,
        WinH = 315,
        TopH = 44,
        SideW = 130
    }

    local State = {
        Minimized = false,
        Collapsed = false,
        Hidden = false,
        SettingsOpen = false
    }

    if config.Accent then Theme.Accent = config.Accent end

    -- Setup Multi-Profile SaveConfig & SaveKey
    if type(config.SaveConfig) == "boolean" then
        Cfg.SaveEnabled = config.SaveConfig
    elseif type(config.SaveConfig) == "table" then
        Cfg.SaveEnabled = config.SaveConfig.Enabled ~= false
        Cfg.SaveKey = config.SaveConfig.SaveKey == true
        if config.SaveConfig.Folder then Cfg.SaveFolder = config.SaveConfig.Folder end
        if config.SaveConfig.DefaultProfile then Cfg.ActiveProfile = tostring(config.SaveConfig.DefaultProfile) end
    end

    local BasePrefix = (type(config.SaveConfig) == "table" and config.SaveConfig.FileName) or tostring(Cfg.Title):gsub("[^%w_-]", "_")
    local KeyStorageFile = Cfg.SaveFolder .. "/" .. BasePrefix .. "_key.txt"

    local function GetProfilePath(profName)
        local clean = tostring(profName):gsub("[^%w_-]", "_")
        if clean == "" then clean = "default" end
        return Cfg.SaveFolder .. "/" .. BasePrefix .. "_" .. clean .. ".json"
    end
    Cfg.SaveFile = GetProfilePath(Cfg.ActiveProfile)

    local function WriteConfigFile()
        if not Cfg.SaveEnabled then return end
        pcall(function()
            if makefolder and isfolder and not isfolder(Cfg.SaveFolder) then makefolder(Cfg.SaveFolder) end
            if writefile then
                Cfg.SavedData["_Haptics"] = Cfg.Haptics
                Cfg.SavedData["_Sounds"] = SoundState.Enabled
                Cfg.SavedData["_SoundPreset"] = SoundState.Preset
                Cfg.SavedData["_UIScale"] = Cfg.UIScale
                Cfg.SavedData["_Accent"] = {Theme.Accent.R, Theme.Accent.G, Theme.Accent.B}
                writefile(Cfg.SaveFile, HttpService:JSONEncode(Cfg.SavedData))
                if Cfg.SaveKey and Cfg.SavedKey then
                    writefile(KeyStorageFile, tostring(Cfg.SavedKey))
                end
            end
        end)
    end

    local function ReadProfileData(profName)
        local path = GetProfilePath(profName)
        local result = nil
        pcall(function()
            if isfile and readfile and isfile(path) then
                local decoded = HttpService:JSONDecode(readfile(path))
                if type(decoded) == "table" then result = decoded end
            end
        end)
        return result
    end

    if config.Sounds ~= nil then TryxzLib:SetSounds(config.Sounds) end

    if Cfg.SaveEnabled then
        pcall(function()
            if isfile and readfile and isfile(KeyStorageFile) then
                Cfg.SavedKey = readfile(KeyStorageFile)
            end
        end)
        local initialData = ReadProfileData(Cfg.ActiveProfile)
        if initialData then
            Cfg.SavedData = initialData
            Cfg.HasExistingSave = true
            if initialData["_Haptics"] ~= nil then Cfg.Haptics = initialData["_Haptics"] end
            if initialData["_Sounds"] ~= nil then SoundState.Enabled = initialData["_Sounds"] end
            if initialData["_UIScale"] ~= nil then Cfg.UIScale = math.clamp(tonumber(initialData["_UIScale"]) or 1, 0.75, 1.35) end
            if initialData["_SoundPreset"] and SoundPresets[initialData["_SoundPreset"]] then
                TryxzLib:SetSoundPreset(initialData["_SoundPreset"])
            end
            if type(initialData["_Accent"]) == "table" and #initialData["_Accent"] == 3 then
                Theme.Accent = Color3.new(initialData["_Accent"][1], initialData["_Accent"][2], initialData["_Accent"][3])
            end
        end
    end

    local function TriggerHaptic(strength)
        if not Cfg.Haptics then return end
        pcall(function()
            HapticService:SetMotor(Enum.UserInputType.Gamepad1, Enum.VibrationMotor.Small, strength or 0.35)
            task.delay(0.06, function()
                HapticService:SetMotor(Enum.UserInputType.Gamepad1, Enum.VibrationMotor.Small, 0)
            end)
        end)
    end

    -- Main Window Frame
    local Main = Instance.new("Frame")
    Main.Name = "MainWindow"
    Main.Size = UDim2.new(0, 0, 0, 0)
    Main.Position = UDim2.new(0.5, -Cfg.WinW/2, 0.5, -Cfg.WinH/2)
    Main.BackgroundColor3 = Theme.Sidebar
    Main.BorderSizePixel = 0
    Main.ClipsDescendants = true
    Main.Visible = false
    Main.Parent = ScreenGui
    Instance.new("UICorner", Main).CornerRadius = UDim.new(0, 18)

    local MainUIScale = Instance.new("UIScale", Main)
    MainUIScale.Scale = Cfg.UIScale

    local MainStroke = Instance.new("UIStroke", Main)
    MainStroke.Color = Theme.Divider
    MainStroke.Thickness = 1.2
    MainStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

    -- Floating UI Button
    local FloatingUIBtn = Instance.new("TextButton")
    FloatingUIBtn.Name = "FloatingUIButton"
    FloatingUIBtn.Size = UDim2.new(0, 0, 0, 0)
    FloatingUIBtn.Position = UDim2.new(0, 18, 0, 70)
    FloatingUIBtn.BackgroundColor3 = Theme.Sidebar
    FloatingUIBtn.Text = "UI"
    FloatingUIBtn.TextColor3 = Theme.Text
    FloatingUIBtn.Font = Enum.Font.GothamBold
    FloatingUIBtn.TextSize = 13
    FloatingUIBtn.AutoButtonColor = false
    FloatingUIBtn.Visible = false
    FloatingUIBtn.ZIndex = 20
    FloatingUIBtn.Parent = ScreenGui
    Instance.new("UICorner", FloatingUIBtn).CornerRadius = UDim.new(1, 0)
    local FloatStroke = Instance.new("UIStroke", FloatingUIBtn)
    FloatStroke.Color = Theme.Accent
    FloatStroke.Thickness = 1.5
    BindAccent(FloatStroke, "Color")

    local function OpenMainWindow(autoKeyBypassed)
        Main.Visible = true
        Tween(Main, Tweens.Bounce, {Size = UDim2.new(0, Cfg.WinW, 0, Cfg.WinH)})
        if autoKeyBypassed then
            task.delay(0.35, function()
                TryxzLib:Notify({
                    Title = "Key & Config Loaded",
                    Text = "Saved key verified and profile '" .. Cfg.ActiveProfile .. "' restored.",
                    Duration = 4
                })
            end)
        elseif Cfg.SaveEnabled and Cfg.HasExistingSave then
            task.delay(0.35, function()
                TryxzLib:Notify({
                    Title = "Config Loaded",
                    Text = "Profile '" .. Cfg.ActiveProfile .. "' restored automatically.",
                    Duration = 4
                })
            end)
        end
    end

    local function CollapseToFloatingUI()
        if State.Collapsed then return end
        State.Collapsed = true
        TriggerHaptic(0.3)
        TryxzLib:PlaySound("Click")
        local closeT = Tween(Main, Tweens.Smooth, {Size = UDim2.new(0, 0, 0, 0)})
        closeT.Completed:Wait()
        Main.Visible = false
        FloatingUIBtn.Visible = true
        Tween(FloatingUIBtn, Tweens.Bounce, {Size = UDim2.new(0, 44, 0, 44)})
    end

    local function RestoreFromFloatingUI()
        if not State.Collapsed then return end
        State.Collapsed = false
        TriggerHaptic(0.3)
        TryxzLib:PlaySound("Click")
        local closeF = Tween(FloatingUIBtn, Tweens.Fast, {Size = UDim2.new(0, 0, 0, 0)})
        closeF.Completed:Wait()
        FloatingUIBtn.Visible = false
        Main.Visible = true
        Tween(Main, Tweens.Bounce, {Size = State.Minimized and UDim2.new(0, Cfg.WinW, 0, Cfg.TopH) or UDim2.new(0, Cfg.WinW, 0, Cfg.WinH)})
    end

    MakeDraggable(FloatingUIBtn, FloatingUIBtn, true, RestoreFromFloatingUI)

    ScreenGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
        if FloatingUIBtn.Visible then
            local s = ScreenGui.AbsoluteSize
            FloatingUIBtn.Position = UDim2.new(
                0, math.clamp(FloatingUIBtn.Position.X.Offset, 8, math.max(8, s.X - 52)),
                0, math.clamp(FloatingUIBtn.Position.Y.Offset, 8, math.max(8, s.Y - 52))
            )
        end
    end)

    -- Check KeySystem + SaveKey
    local KeyConfig = config.KeySystem
    if KeyConfig and KeyConfig.Enabled ~= false then
        if Cfg.SaveEnabled and Cfg.SaveKey and Cfg.SavedKey and CheckKeyValid(KeyConfig, Cfg.SavedKey) then
            OpenMainWindow(true)
        else
            BuildKeySystem(KeyConfig, Cfg, TriggerHaptic, WriteConfigFile, OpenMainWindow)
        end
    else
        OpenMainWindow(false)
    end

    -- Topbar
    local Topbar = Instance.new("Frame")
    Topbar.Size = UDim2.new(1, 0, 0, Cfg.TopH)
    Topbar.BackgroundTransparency = 1
    Topbar.ZIndex = 5
    Topbar.Parent = Main
    MakeDraggable(Topbar, Main, false)

    local TopDivider = Instance.new("Frame")
    TopDivider.Size = UDim2.new(1, 0, 0, 1)
    TopDivider.Position = UDim2.new(0, 0, 1, -1)
    TopDivider.BackgroundColor3 = Theme.Divider
    TopDivider.BorderSizePixel = 0
    TopDivider.ZIndex = 6
    TopDivider.Parent = Topbar

    local hasWinIcon = Cfg.Icon ~= nil and tostring(Cfg.Icon) ~= ""
    if hasWinIcon then CreateIcon(Topbar, Cfg.Icon, 20, UDim2.new(0, 14, 0.5, -10), 6) end

    local textStartX = hasWinIcon and 40 or 16
    local rightReserved = Cfg.Stats and 204 or 104

    local TitleLabel = Instance.new("TextLabel")
    TitleLabel.Size = UDim2.new(1, -(textStartX + rightReserved), 0, Cfg.Subtitle ~= "" and 18 or 24)
    TitleLabel.Position = UDim2.new(0, textStartX, 0, Cfg.Subtitle ~= "" and 6 or 10)
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Text = Cfg.Title
    TitleLabel.TextColor3 = Theme.Text
    TitleLabel.Font = Enum.Font.GothamBold
    TitleLabel.TextSize = 13
    TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
    TitleLabel.TextTruncate = Enum.TextTruncate.AtEnd
    TitleLabel.ZIndex = 6
    TitleLabel.Parent = Topbar

    if Cfg.Subtitle ~= "" then
        local SubLabel = Instance.new("TextLabel")
        SubLabel.Size = UDim2.new(1, -(textStartX + rightReserved), 0, 14)
        SubLabel.Position = UDim2.new(0, textStartX, 0, 23)
        SubLabel.BackgroundTransparency = 1
        SubLabel.Text = Cfg.Subtitle
        SubLabel.TextColor3 = Theme.SubText
        SubLabel.Font = Enum.Font.Gotham
        SubLabel.TextSize = 10
        SubLabel.TextXAlignment = Enum.TextXAlignment.Left
        SubLabel.TextTruncate = Enum.TextTruncate.AtEnd
        SubLabel.ZIndex = 6
        SubLabel.Parent = Topbar
    end

    local MinBtn = Instance.new("TextButton")
    MinBtn.Size = UDim2.new(0, 24, 0, 24)
    MinBtn.Position = UDim2.new(1, -34, 0.5, -12)
    MinBtn.BackgroundColor3 = Theme.Element
    MinBtn.Text = "-"
    MinBtn.TextColor3 = Theme.Text
    MinBtn.Font = Enum.Font.GothamBold
    MinBtn.TextSize = 14
    MinBtn.AutoButtonColor = false
    MinBtn.ZIndex = 6
    MinBtn.Parent = Topbar
    Instance.new("UICorner", MinBtn).CornerRadius = UDim.new(1, 0)

    local SettingsBtn = Instance.new("TextButton")
    SettingsBtn.Size = UDim2.new(0, 24, 0, 24)
    SettingsBtn.Position = UDim2.new(1, -64, 0.5, -12)
    SettingsBtn.BackgroundColor3 = Theme.Element
    SettingsBtn.Text = "⚙"
    SettingsBtn.TextColor3 = Theme.Text
    SettingsBtn.Font = Enum.Font.GothamBold
    SettingsBtn.TextSize = 12
    SettingsBtn.AutoButtonColor = false
    SettingsBtn.ZIndex = 6
    SettingsBtn.Parent = Topbar
    Instance.new("UICorner", SettingsBtn).CornerRadius = UDim.new(1, 0)
    BindAccent(SettingsBtn, "BackgroundColor3", function() return State.SettingsOpen end)

    local CollapseUIBtn = Instance.new("TextButton")
    CollapseUIBtn.Size = UDim2.new(0, 26, 0, 24)
    CollapseUIBtn.Position = UDim2.new(1, -96, 0.5, -12)
    CollapseUIBtn.BackgroundColor3 = Theme.Element
    CollapseUIBtn.Text = "UI"
    CollapseUIBtn.TextColor3 = Theme.Accent
    CollapseUIBtn.Font = Enum.Font.GothamBold
    CollapseUIBtn.TextSize = 10
    CollapseUIBtn.AutoButtonColor = false
    CollapseUIBtn.ZIndex = 6
    CollapseUIBtn.Parent = Topbar
    Instance.new("UICorner", CollapseUIBtn).CornerRadius = UDim.new(1, 0)
    BindAccent(CollapseUIBtn, "TextColor3")
    local CollapseStroke = Instance.new("UIStroke", CollapseUIBtn)
    CollapseStroke.Color = Theme.Accent
    CollapseStroke.Thickness = 1
    CollapseStroke.Transparency = 0.5
    BindAccent(CollapseStroke, "Color")
    CollapseUIBtn.MouseButton1Click:Connect(CollapseToFloatingUI)

    local StatsConnection
    if Cfg.Stats then
        local StatsPill = Instance.new("Frame")
        StatsPill.Size = UDim2.new(0, 94, 0, 24)
        StatsPill.Position = UDim2.new(1, -196, 0.5, -12)
        StatsPill.BackgroundColor3 = Theme.Element
        StatsPill.ZIndex = 6
        StatsPill.Parent = Topbar
        Instance.new("UICorner", StatsPill).CornerRadius = UDim.new(1, 0)

        local StatsLbl = Instance.new("TextLabel")
        StatsLbl.Size = UDim2.new(1, -8, 1, 0)
        StatsLbl.Position = UDim2.new(0, 4, 0, 0)
        StatsLbl.BackgroundTransparency = 1
        StatsLbl.Text = "60 FPS | 0 ms"
        StatsLbl.TextColor3 = Theme.SubText
        StatsLbl.Font = Enum.Font.GothamSemibold
        StatsLbl.TextSize = 9
        StatsLbl.ZIndex = 7
        StatsLbl.Parent = StatsPill

        local frames, lastUpdate = 0, tick()
        StatsConnection = RunService.RenderStepped:Connect(function()
            frames += 1
            local now = tick()
            if now - lastUpdate >= 0.5 then
                local fps = math.floor(frames / (now - lastUpdate))
                local ping = 0
                pcall(function() ping = math.floor(StatsService.Network.ServerStatsItem["Data Ping"]:GetValue()) end)
                StatsLbl.Text = string.format("%d FPS | %d ms", fps, ping)
                frames, lastUpdate = 0, now
            end
        end)
    end

    for _, btn in ipairs({MinBtn, SettingsBtn, CollapseUIBtn}) do
        btn.MouseEnter:Connect(function()
            if not (btn == SettingsBtn and State.SettingsOpen) then
                Tween(btn, Tweens.Fast, {BackgroundColor3 = Theme.ElementHover})
            end
        end)
        btn.MouseLeave:Connect(function()
            if not (btn == SettingsBtn and State.SettingsOpen) then
                Tween(btn, Tweens.Fast, {BackgroundColor3 = Theme.Element})
            end
        end)
    end

    local BodyContainer = Instance.new("Frame")
    BodyContainer.Size = UDim2.new(1, 0, 1, -Cfg.TopH)
    BodyContainer.Position = UDim2.new(0, 0, 0, Cfg.TopH)
    BodyContainer.BackgroundTransparency = 1
    BodyContainer.Parent = Main

    MinBtn.MouseButton1Click:Connect(function()
        TriggerHaptic(0.25)
        TryxzLib:PlaySound("Click")
        State.Minimized = not State.Minimized
        if State.Minimized then
            MinBtn.Text = "+"
            BodyContainer.Visible = false
            TopDivider.Visible = false
            Tween(Main, Tweens.Smooth, {Size = UDim2.new(0, Cfg.WinW, 0, Cfg.TopH)})
        else
            MinBtn.Text = "-"
