local function FormatAssetId(val)
    local s = tostring(val)
    return tonumber(s) and ("rbxassetid://" .. s) or s
end

function TryxzLib:RegisterSound(name, soundId)
    if name and soundId then CustomNamedSounds[tostring(name)] = FormatAssetId(soundId) end
end

function TryxzLib:AddSoundPack(packName, packTable)
    if not packName or type(packTable) ~= "table" then return end
    local base = SoundPresets["Soft Pop"]
    SoundPresets[packName] = {
        Click = packTable.Click and FormatAssetId(packTable.Click) or base.Click,
        Hover = packTable.Hover and FormatAssetId(packTable.Hover) or base.Hover,
        Toggle = packTable.Toggle and FormatAssetId(packTable.Toggle) or base.Toggle,
        Notify = packTable.Notify and FormatAssetId(packTable.Notify) or base.Notify,
        Success = packTable.Success and FormatAssetId(packTable.Success) or base.Success,
        Error = packTable.Error and FormatAssetId(packTable.Error) or base.Error
    }
    if not table.find(PresetOrder, packName) then table.insert(PresetOrder, packName) end
end

function TryxzLib:SetSoundPreset(presetName)
    local preset = SoundPresets[presetName]
    if preset then
        SoundState.Preset = presetName
        for k, v in pairs(preset) do SoundState[k] = v end
    end
end

function TryxzLib:SetSounds(soundTable)
    if type(soundTable) == "boolean" then SoundState.Enabled = soundTable return end
    if type(soundTable) ~= "table" then return end
    if soundTable.Enabled ~= nil then SoundState.Enabled = soundTable.Enabled end
    if soundTable.Volume ~= nil then SoundState.Volume = soundTable.Volume end
    if type(soundTable.Packs) == "table" then
        for pName, pTbl in pairs(soundTable.Packs) do TryxzLib:AddSoundPack(pName, pTbl) end
    end
    if type(soundTable.Custom) == "table" then
        for sName, sId in pairs(soundTable.Custom) do TryxzLib:RegisterSound(sName, sId) end
    end
    if soundTable.Preset and SoundPresets[soundTable.Preset] then
        TryxzLib:SetSoundPreset(soundTable.Preset)
    end
    for _, key in ipairs({"Click", "Hover", "Toggle", "Notify", "Success", "Error"}) do
        if soundTable[key] ~= nil then SoundState[key] = FormatAssetId(soundTable[key]) end
    end
end

function TryxzLib:PlaySound(soundOrType, customVolume)
    for _, cb in ipairs(SoundPulseCallbacks) do
        task.spawn(cb, soundOrType)
    end
    if not SoundState.Enabled then return end
    local id = CustomNamedSounds[soundOrType] or SoundState[soundOrType] or tostring(soundOrType)
    if not id or id == "" or id == "none" then return end
    id = FormatAssetId(id)
    task.spawn(function()
        pcall(function()
            local snd = Instance.new("Sound")
            snd.SoundId = id
            snd.Volume = customVolume or SoundState.Volume
            snd.Parent = SoundService
            snd:Play()
            snd.Ended:Connect(function() snd:Destroy() end)
            task.delay(4, function() if snd and snd.Parent then snd:Destroy() end end)
        end)
    end)
end

