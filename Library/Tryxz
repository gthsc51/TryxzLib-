            LowKnob.Position = UDim2.new(p1, 0, 0.5, 0)
            HighKnob.Position = UDim2.new(p2, 0, 0.5, 0)
            RangeLbl.Text = string.format("%d - %d", LowVal, HighVal)
            if saveNow and Flag then
                Cfg.SavedData[Flag] = {LowVal, HighVal}
                WriteConfigFile()
            end
            task.spawn(Callback, LowVal, HighVal)
        end

        RefreshRange(false)

        local activeThumb = nil
        local function UpdateRangeInput(inp)
            local pos = math.clamp((inp.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
            local raw = math.floor(Min + (Max - Min) * pos + 0.5)
            if activeThumb == "low" then
                LowVal = math.clamp(raw, Min, HighVal)
            elseif activeThumb == "high" then
                HighVal = math.clamp(raw, LowVal, Max)
            end
            RefreshRange(false)
        end

        Track.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                local pos = math.clamp((inp.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
                local p1 = (LowVal - Min) / (Max - Min)
                local p2 = (HighVal - Min) / (Max - Min)
                activeThumb = (math.abs(pos - p1) <= math.abs(pos - p2)) and "low" or "high"
                UpdateRangeInput(inp)
            end
        end)
        UserInputService.InputChanged:Connect(function(inp)
            if activeThumb and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
                UpdateRangeInput(inp)
            end
        end)
        UserInputService.InputEnded:Connect(function(inp)
            if (inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch) and activeThumb then
                activeThumb = nil
                RefreshRange(true)
            end
        end)

        local RangeObj = WrapElementControls(Frame, rCfg)
        function RangeObj:Set(tbl, skipWrite)
            if type(tbl) == "table" and #tbl == 2 then
                LowVal = math.clamp(tbl[1], Min, Max)
                HighVal = math.clamp(tbl[2], LowVal, Max)
                RefreshRange(not skipWrite)
            end
        end
        if Flag then Window.Flags[Flag] = RangeObj end
        return RangeObj
    end

