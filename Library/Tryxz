        local LockLbl = Instance.new("TextLabel")
        LockLbl.Size = UDim2.new(1, -16, 1, 0)
        LockLbl.Position = UDim2.new(0, 8, 0, 0)
        LockLbl.BackgroundTransparency = 1
        LockLbl.Text = "🔒 Locked"
        LockLbl.TextColor3 = Theme.Text
        LockLbl.Font = Enum.Font.GothamBold
        LockLbl.TextSize = 11
        LockLbl.ZIndex = 26
        LockLbl.Parent = LockOverlay

        LockOverlay.MouseButton1Click:Connect(function()
            TriggerHaptic(0.35)
            TryxzLib:PlaySound("Error", 0.25)
        end)

        if type(eCfg) == "table" then
            if eCfg.Locked then
                Locked = true
                LockLbl.Text = "🔒 " .. tostring(eCfg.LockReason or "Locked")
                LockOverlay.Visible = true
            end
            if type(eCfg.VisibleIf) == "function" then
                table.insert(Window.VisibilityRules, {Obj = rootObj, Cond = eCfg.VisibleIf})
                rootObj.Visible = eCfg.VisibleIf() == true
            end
        end

        return {
            SetLocked = function(_, state, reason)
                Locked = state == true
                LockLbl.Text = "🔒 " .. tostring(reason or "Locked")
                LockOverlay.Visible = Locked
            end,
            SetVisible = function(_, vis)
                rootObj.Visible = vis == true
            end
        }
    end

