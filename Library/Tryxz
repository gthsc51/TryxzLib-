                local OptTxt = Instance.new("TextLabel")
                OptTxt.Size = UDim2.new(1, badge and -34 or -14, 1, 0)
                OptTxt.Position = UDim2.new(0, badge and 30 or 10, 0, 0)
                OptTxt.BackgroundTransparency = 1
                OptTxt.Text = optLabel
                OptTxt.TextColor3 = Theme.SubText
                OptTxt.Font = Enum.Font.Gotham
                OptTxt.TextSize = 11
                OptTxt.TextXAlignment = Enum.TextXAlignment.Left
                OptTxt.ZIndex = 3
                OptTxt.Parent = OptBtn

                OptBtn.MouseEnter:Connect(function()
                    Tween(OptBtn, Tweens.Fast, {BackgroundColor3 = Theme.ElementHover})
                    Tween(OptTxt, Tweens.Fast, {TextColor3 = Theme.Text})
                end)
                OptBtn.MouseLeave:Connect(function()
                    Tween(OptBtn, Tweens.Fast, {BackgroundColor3 = Theme.Background})
                    Tween(OptTxt, Tweens.Fast, {TextColor3 = Theme.SubText})
                end)
                OptBtn.MouseButton1Click:Connect(function()
                    SpawnRipple(OptBtn, Theme.Accent)
                    SelectedLbl.Text = optLabel
                    if Flag then Cfg.SavedData[Flag] = optValue WriteConfigFile() end
                    ToggleDrop()
                    task.spawn(Callback, optValue)
                end)

                table.insert(OptEntries, {Btn = OptBtn, Label = optLabel})
            end
            ListHolder.Size = UDim2.new(1, -12, 0, math.min(math.max(1, #Options), 6) * 26)
        end

        RebuildOptions(Options, OptIcons)

        if FilterBox then
            FilterBox:GetPropertyChangedSignal("Text"):Connect(function()
                local q = string.lower(FilterBox.Text)
                VisibleCount = 0
                for _, item in ipairs(OptEntries) do
                    local match = (q == "") or (string.find(string.lower(item.Label), q, 1, true) ~= nil)
                    item.Btn.Visible = match
                    if match then VisibleCount += 1 end
                end
                if Open then
                    Tween(DropFrame, Tweens.Fast, {Size = UDim2.new(1, 0, 0, GetOpenHeight())})
                end
            end)
        end

        if Cfg.SaveEnabled and Flag and Cfg.SavedData[Flag] ~= nil then task.spawn(Callback, Default) end

