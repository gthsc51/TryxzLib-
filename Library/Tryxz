local function RefreshAllThemeBindings()
    for i = #ThemeBindings, 1, -1 do
        local entry = ThemeBindings[i]
        if entry.Obj and entry.Obj.Parent then
            if not entry.Cond or entry.Cond() then
                local col = Theme[entry.Key]
                if col then
                    Tween(entry.Obj, Tweens.Fast, {[entry.Prop] = col})
                end
            end
        else
            table.remove(ThemeBindings, i)
        end
    end
    for i = #GradientBindings, 1, -1 do
        local g = GradientBindings[i]
        if g and g.Parent then
            g.Color = ColorSequence.new{
                ColorSequenceKeypoint.new(0, Theme.Accent),
                ColorSequenceKeypoint.new(0.5, Theme.AccentSecondary or Theme.Accent),
                ColorSequenceKeypoint.new(1, Theme.Accent)
            }
        else
            table.remove(GradientBindings, i)
        end
    end
    for _, cb in ipairs(ThemeChangeCallbacks) do
        task.spawn(cb, ActiveThemeName)
    end
end

function TryxzLib:SetTheme(themeName)
    local preset = Themes[themeName]
    if not preset then return end
    ActiveThemeName = themeName
    for k, v in pairs(preset) do
        Theme[k] = v
    end
    RefreshAllThemeBindings()
end

function TryxzLib:AddTheme(themeName, paletteTable)
    if not themeName or type(paletteTable) ~= "table" then return end
    local base = Themes["Obsidian"]
    local newPal = {}
    for k, v in pairs(base) do
        newPal[k] = paletteTable[k] or v
    end
    if paletteTable.Accent and not paletteTable.AccentHover then
        local h, s, v = paletteTable.Accent:ToHSV()
        newPal.AccentHover = Color3.fromHSV(h, math.max(0, s - 0.08), math.min(1, v + 0.08))
    end
    if paletteTable.Accent and not paletteTable.AccentSecondary then
        local h, s, v = paletteTable.Accent:ToHSV()
        newPal.AccentSecondary = Color3.fromHSV((h + 0.08) % 1, s, math.min(1, v + 0.06))
    end
    Themes[themeName] = newPal
    if not table.find(ThemeOrder, themeName) then
        table.insert(ThemeOrder, themeName)
    end
end

function TryxzLib:SetAccent(newColor)
    Theme.Accent = newColor
    local h, s, v = newColor:ToHSV()
    Theme.AccentHover = Color3.fromHSV(h, math.max(0, s - 0.08), math.min(1, v + 0.08))
    Theme.AccentSecondary = Color3.fromHSV((h + 0.08) % 1, s, math.min(1, v + 0.06))
    RefreshAllThemeBindings()
end

