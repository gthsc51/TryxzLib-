            Track.BackgroundColor3 = Theme.Background
            Track.Text = ""
            Track.AutoButtonColor = false
            Track.Parent = SliderFrame
            Instance.new("UICorner", Track).CornerRadius = UDim.new(1, 0)

            local Fill = Instance.new("Frame")
            Fill.Size = UDim2.new((Default - Min) / (Max - Min), 0, 1, 0)
            Fill.BackgroundColor3 = Theme.Accent
            Fill.Parent = Track
            Instance.new("UICorner", Fill).CornerRadius = UDim.new(1, 0)

            local Dot = Instance.new("Frame")
            Dot.Size = UDim2.new(0, 11, 0, 11)
            Dot.Position = UDim2.new(1, 0, 0.5, 0)
            Dot.AnchorPoint = Vector2.new(0.5, 0.5)
            Dot.BackgroundColor3 = Theme.Text
            Dot.Parent = Fill
            Instance.new("UICorner", Dot).CornerRadius = UDim.new(1, 0)

            local Sliding, lastVal = false, Default
            local function SetSlider(val, silent)
                val = math.clamp(math.floor(val + 0.5), Min, Max)
                if val ~= lastVal then
                    lastVal = val
                    if not silent then TriggerHaptic(0.12) tryxzlib:PlaySound("Hover", 0.15) end
                end
                if Flag then Cfg.SavedData[Flag] = val end
                ValueLbl.Text = tostring(val)
                Tween(Fill, TweenInfo.new(0.08, Enum.EasingStyle.Quad), {Size = UDim2.new((val - Min) / (Max - Min), 0, 1, 0)})
                task.spawn(Callback, val)
            end

            local function UpdateFromInput(input)
                local pos = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
                SetSlider(Min + (Max - Min) * pos, false)
            end

            Track.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    Sliding = true
                    Tween(Dot, Tweens.Fast, {Size = UDim2.new(0, 14, 0, 14)})
                    UpdateFromInput(input)
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if Sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    UpdateFromInput(input)
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and Sliding then
                    Sliding = false
                    WriteConfigFile()
                    Tween(Dot, Tweens.Fast, {Size = UDim2.new(0, 11, 0, 11)})
                end
            end)

            task.spawn(Callback, Default)

            local SliderObj = {}
            function SliderObj:Set(val) SetSlider(val, true) WriteConfigFile() end
            if Flag then Window.Flags[Flag] = SliderObj end
            return SliderObj
        end

