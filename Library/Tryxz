    DestroyBtn.Size = UDim2.new(1, 0, 0, 32)
    DestroyBtn.BackgroundColor3 = Theme.Error
    DestroyBtn.Text = "Unload / Destroy UI"
    DestroyBtn.TextColor3 = Theme.Text
    DestroyBtn.Font = Enum.Font.GothamBold
    DestroyBtn.TextSize = 12
    DestroyBtn.AutoButtonColor = false
    DestroyBtn.ClipsDescendants = true
    DestroyBtn.ZIndex = 11
    DestroyBtn.Parent = SettingsPage
    Instance.new("UICorner", DestroyBtn).CornerRadius = UDim.new(0, 12)

    DestroyBtn.MouseButton1Click:Connect(function()
        SpawnRipple(DestroyBtn)
        TryxzLib:Dialog({
            Title = "Unload TryxzLib",
            Content = "Are you sure you want to close and unload the UI?",
            ConfirmText = "Unload",
            CancelText = "Stay",
            OnConfirm = function()
                SetBlurActive(false)
                if StatsConnection then StatsConnection:Disconnect() end
                local t = Tween(WindowHolder, Tweens.Fast, {Size = UDim2.new(0, 0, 0, 0)})
                t.Completed:Wait()
                DestroyBlur()
                ScreenGui:Destroy()
            end
        })
    end)

    SettingsBtn.MouseButton1Click:Connect(function()
        if State.Minimized then return end
        TriggerHaptic(0.25)
        TryxzLib:PlaySound("Click")
        State.SettingsOpen = not State.SettingsOpen
        Tween(SettingsBtn, Tweens.Smooth, {Rotation = State.SettingsOpen and 90 or 0, BackgroundColor3 = State.SettingsOpen and Theme.Accent or Theme.Element})
        Tween(SettingsPage, Tweens.Smooth, {Position = State.SettingsOpen and UDim2.new(0, 0, 0, 0) or UDim2.new(0, 0, 1, 0)})
    end)

    function Window:Save() WriteConfigFile() end
    function Window:RegisterKeybind(bindInfo) RegisterBindable(bindInfo) end

    function Window:CreateTab(name, icon)
        Window.TabOrder += 1
        local tabText = tostring(name or "Tab")
        local hasIcon = icon ~= nil and tostring(icon) ~= ""
        local isLongName = #tabText > 16

        if isLongName and Cfg.SideW < 185 then
            Cfg.SideW = 185
            Sidebar.Size = UDim2.new(0, Cfg.SideW, 1, 0)
            PagesContainer.Size = UDim2.new(1, -(Cfg.SideW + 6), 1, -6)
            PagesContainer.Position = UDim2.new(0, Cfg.SideW, 0, 0)
        end

        local TabBtn = Instance.new("TextButton")
        TabBtn.LayoutOrder = Window.TabOrder
        TabBtn.Size = UDim2.new(1, 0, 0, isLongName and 38 or 28)
        TabBtn.BackgroundColor3 = Theme.Sidebar
        TabBtn.Text = ""
        TabBtn.AutoButtonColor = false
        TabBtn.ClipsDescendants = true
        TabBtn.Parent = TabContainer
        Instance.new("UICorner", TabBtn).CornerRadius = UDim.new(0, 10)

        local TabStroke = Instance.new("UIStroke", TabBtn)
        TabStroke.Color = Theme.Accent
        TabStroke.Thickness = 1
        TabStroke.Transparency = 1
        BindAccent(TabStroke, "Color")

        local Indicator = Instance.new("Frame")
        Indicator.Size = UDim2.new(0, 3, 0, 0)
        Indicator.Position = UDim2.new(0, 2, 0.5, 0)
        Indicator.AnchorPoint = Vector2.new(0, 0.5)
        Indicator.BackgroundColor3 = Color3.new(1, 1, 1)
        Indicator.BorderSizePixel = 0
        Indicator.Parent = TabBtn
        Instance.new("UICorner", Indicator).CornerRadius = UDim.new(1, 0)
        ApplyAccentGradient(Indicator, 90)

        if hasIcon then CreateIcon(TabBtn, icon, 14, UDim2.new(0, 10, 0.5, -7), 2) end

        local TabBadge = Instance.new("TextLabel")
        TabBadge.Size = UDim2.new(0, 0, 0, 14)
        TabBadge.AutomaticSize = Enum.AutomaticSize.X
        TabBadge.Position = UDim2.new(1, -6, 0.5, -7)
        TabBadge.AnchorPoint = Vector2.new(1, 0)
        TabBadge.BackgroundColor3 = Theme.Accent
        TabBadge.Text = ""
        TabBadge.TextColor3 = Theme.Text
        TabBadge.Font = Enum.Font.GothamBlack
        TabBadge.TextSize = 8
        TabBadge.Visible = false
        TabBadge.ZIndex = 3
        TabBadge.Parent = TabBtn
        Instance.new("UICorner", TabBadge).CornerRadius = UDim.new(1, 0)
        BindAccent(TabBadge, "BackgroundColor3")

        local TabLbl = Instance.new("TextLabel")
        TabLbl.Size = UDim2.new(1, hasIcon and -34 or -16, 1, 0)
        TabLbl.Position = UDim2.new(0, hasIcon and 28 or 10, 0, 0)
        TabLbl.BackgroundTransparency = 1
        TabLbl.Text = tabText
        TabLbl.TextColor3 = Theme.SubText
        TabLbl.Font = Enum.Font.GothamSemibold
        TabLbl.TextSize = 10
        TabLbl.TextWrapped = true
        TabLbl.TextXAlignment = Enum.TextXAlignment.Left
        TabLbl.Parent = TabBtn

        local TabWrapper = Instance.new("Frame")
        TabWrapper.Size = UDim2.new(1, 0, 1, -PageTopOffset)
        TabWrapper.Position = UDim2.new(0, 16, 0, PageTopOffset)
        TabWrapper.BackgroundTransparency = 1
        TabWrapper.Visible = false
        TabWrapper.Parent = PagesContainer

        local DefaultPage = Instance.new("ScrollingFrame")
        DefaultPage.Size = UDim2.new(1, 0, 1, 0)
        DefaultPage.BackgroundTransparency = 1
        DefaultPage.ScrollBarThickness = 2
        DefaultPage.ScrollBarImageColor3 = Theme.Accent
        DefaultPage.CanvasSize = UDim2.new(0, 0, 0, 0)
        DefaultPage.AutomaticCanvasSize = Enum.AutomaticSize.Y
        DefaultPage.Parent = TabWrapper
        BindAccent(DefaultPage, "ScrollBarImageColor3")

        local PagePad = Instance.new("UIPadding", DefaultPage)
        PagePad.PaddingTop, PagePad.PaddingBottom = UDim.new(0, 8), UDim.new(0, 10)
        PagePad.PaddingLeft, PagePad.PaddingRight = UDim.new(0, 10), UDim.new(0, 10)

        local PageLayout = Instance.new("UIListLayout", DefaultPage)
        PageLayout.Padding = UDim.new(0, 6)
        PageLayout.SortOrder = Enum.SortOrder.LayoutOrder

        local TabData = {Btn = TabBtn, Lbl = TabLbl, Page = TabWrapper, Indicator = Indicator, Stroke = TabStroke, Items = {}}
        BindTheme(TabBtn, "BackgroundColor3", "Element", function() return TabWrapper.Visible end)
        BindTheme(TabBtn, "BackgroundColor3", "Sidebar", function() return not TabWrapper.Visible end)

        local function SelectTab()
            if State.SettingsOpen then
                State.SettingsOpen = false
                Tween(SettingsBtn, Tweens.Smooth, {Rotation = 0, BackgroundColor3 = Theme.Element})
                Tween(SettingsPage, Tweens.Smooth, {Position = UDim2.new(0, 0, 1, 0)})
            end
            for _, t in ipairs(Window.Tabs) do
                t.Page.Visible = false
                Tween(t.Btn, Tweens.Fast, {BackgroundColor3 = Theme.Sidebar})
                Tween(t.Lbl, Tweens.Fast, {TextColor3 = Theme.SubText})
                Tween(t.Stroke, Tweens.Fast, {Transparency = 1})
                Tween(t.Indicator, Tweens.Fast, {Size = UDim2.new(0, 3, 0, 0)})
            end
            TabWrapper.Visible = true
            TabWrapper.Position = UDim2.new(0, 12, 0, PageTopOffset)
            Tween(TabWrapper, Tweens.Smooth, {Position = UDim2.new(0, 0, 0, PageTopOffset)})
            Tween(TabBtn, Tweens.Fast, {BackgroundColor3 = Theme.Element})
            Tween(TabLbl, Tweens.Fast, {TextColor3 = Theme.Text})
            Tween(TabStroke, Tweens.Fast, {Transparency = 0.55})
            Tween(Indicator, Tweens.Bounce, {Size = UDim2.new(0, 3, 0, isLongName and 22 or 14)})
            ScrambleText(TabLbl, tabText, 0.25)
        end

        TabBtn.MouseButton1Click:Connect(function()
            SpawnRipple(TabBtn, Theme.Accent)
            TriggerHaptic(0.2)
            TryxzLib:PlaySound("Click")
            SelectTab()
        end)

        table.insert(Window.Tabs, TabData)
        if #Window.Tabs == 1 then SelectTab() end

        local function RegisterSearchable(nameStr, obj)
            table.insert(TabData.Items, {Name = tostring(nameStr or ""), Obj = obj})
        end

        local TabAPI = CreateElementFactory(DefaultPage, Window, Cfg, TriggerHaptic, WriteConfigFile, RegisterSearchable, RegisterBindable)

        function TabAPI:SetBadge(badgeText)
            if badgeText and tostring(badgeText) ~= "" then
                TabBadge.Text = " " .. tostring(badgeText) .. " "
                TabBadge.Visible = true
                TabLbl.Size = UDim2.new(1, hasIcon and -62 or -44, 1, 0)
            else
                TabBadge.Visible = false
                TabLbl.Size = UDim2.new(1, hasIcon and -34 or -16, 1, 0)
            end
        end

        local SubTabBar, SubTabs = nil, {}
        function TabAPI:AddSubTab(subName)
            if not SubTabBar then
                DefaultPage.Visible = false
                SubTabBar = Instance.new("ScrollingFrame")
                SubTabBar.Size = UDim2.new(1, -20, 0, 28)
                SubTabBar.Position = UDim2.new(0, 10, 0, 6)
                SubTabBar.BackgroundColor3 = Theme.Element
                SubTabBar.ScrollBarThickness = 0
                SubTabBar.AutomaticCanvasSize = Enum.AutomaticSize.X
                SubTabBar.CanvasSize = UDim2.new(0, 0, 0, 0)
                SubTabBar.Parent = TabWrapper
                Instance.new("UICorner", SubTabBar).CornerRadius = UDim.new(1, 0)
                BindTheme(SubTabBar, "BackgroundColor3", "Element")

                local SubBarStroke = Instance.new("UIStroke", SubTabBar)
                SubBarStroke.Color = Theme.Divider
                SubBarStroke.Thickness = 1
                SubBarStroke.Transparency = 0.5

                local SBarPad = Instance.new("UIPadding", SubTabBar)
                SBarPad.PaddingTop, SBarPad.PaddingBottom = UDim.new(0, 3), UDim.new(0, 3)
                SBarPad.PaddingLeft, SBarPad.PaddingRight = UDim.new(0, 4), UDim.new(0, 4)

                local SBarList = Instance.new("UIListLayout", SubTabBar)
                SBarList.FillDirection = Enum.FillDirection.Horizontal
                SBarList.Padding = UDim.new(0, 4)
            end

            local SubBtn = Instance.new("TextButton")
            SubBtn.Size = UDim2.new(0, 0, 1, 0)
            SubBtn.AutomaticSize = Enum.AutomaticSize.X
            SubBtn.BackgroundColor3 = Theme.Element
            SubBtn.Text = subName
            SubBtn.TextColor3 = Theme.SubText
            SubBtn.Font = Enum.Font.GothamBold
            SubBtn.TextSize = 10
            SubBtn.AutoButtonColor = false
            SubBtn.ClipsDescendants = true
            SubBtn.Parent = SubTabBar
            Instance.new("UICorner", SubBtn).CornerRadius = UDim.new(1, 0)

            local SubBtnPad = Instance.new("UIPadding", SubBtn)
            SubBtnPad.PaddingLeft, SubBtnPad.PaddingRight = UDim.new(0, 11), UDim.new(0, 11)

            local SubPage = Instance.new("ScrollingFrame")
            SubPage.Size = UDim2.new(1, 0, 1, -38)
            SubPage.Position = UDim2.new(0, 0, 0, 38)
            SubPage.BackgroundTransparency = 1
            SubPage.ScrollBarThickness = 2
            SubPage.ScrollBarImageColor3 = Theme.Accent
            SubPage.Visible = false
            SubPage.CanvasSize = UDim2.new(0, 0, 0, 0)
            SubPage.AutomaticCanvasSize = Enum.AutomaticSize.Y
            SubPage.Parent = TabWrapper
            BindAccent(SubPage, "ScrollBarImageColor3")

            local SPad = Instance.new("UIPadding", SubPage)
            SPad.PaddingTop, SPad.PaddingBottom = UDim.new(0, 4), UDim.new(0, 10)
            SPad.PaddingLeft, SPad.PaddingRight = UDim.new(0, 10), UDim.new(0, 10)

            local SList = Instance.new("UIListLayout", SubPage)
            SList.Padding = UDim.new(0, 6)
            SList.SortOrder = Enum.SortOrder.LayoutOrder

            local subEntry = {Btn = SubBtn, Page = SubPage, Active = false}
            BindAccent(SubBtn, "BackgroundColor3", function() return subEntry.Active end)

            local function SelectSubTab()
                for _, st in ipairs(SubTabs) do
                    st.Active = false
                    st.Page.Visible = false
                    Tween(st.Btn, Tweens.Fast, {BackgroundColor3 = Theme.Element, TextColor3 = Theme.SubText})
                end
                subEntry.Active = true
                SubPage.Visible = true
                Tween(SubBtn, Tweens.Fast, {BackgroundColor3 = Theme.Accent, TextColor3 = Color3.fromRGB(255, 255, 255)})
            end

            SubBtn.MouseButton1Click:Connect(function()
                SpawnRipple(SubBtn)
                TriggerHaptic(0.2)
                TryxzLib:PlaySound("Click")
                SelectSubTab()
            end)

            table.insert(SubTabs, subEntry)
            if #SubTabs == 1 then SelectSubTab() end

            return CreateElementFactory(SubPage, Window, Cfg, TriggerHaptic, WriteConfigFile, RegisterSearchable, RegisterBindable)
        end

        return TabAPI
    end

    return Window
end

return TryxzLib
 
